  .op-cap.cap-above::before { top: auto; bottom: calc(-26 * var(--u)); transform-origin: 50% 100%; }
  /* légende à côté de l'image, alignée sur son bas (ou son haut) ; le filet devient horizontal et part du bord de la photo */
  .op-cap:is(.cap-right, .cap-left, .cap-right-top, .cap-left-top, .cap-right-mid, .cap-left-mid) { top: auto; bottom: 0; width: calc(300 * var(--u)); }
  .op-cap:is(.cap-right-top, .cap-left-top) { top: 0; bottom: auto; }
  .op-cap:is(.cap-right, .cap-right-top, .cap-right-mid) { left: calc(100% + 28 * var(--u)); }
  .op-cap:is(.cap-left, .cap-left-top, .cap-left-mid) { left: auto; right: calc(100% + 28 * var(--u)); text-align: right; justify-items: end; }
  .op-cap:is(.cap-right, .cap-left, .cap-right-top, .cap-left-top, .cap-right-mid, .cap-left-mid)::before { top: auto; bottom: calc(26 * var(--u)); width: calc(20 * var(--u)); height: 1px; scale: 0 1; }
  .op-cap:is(.cap-right-top, .cap-left-top)::before { top: calc(0.45em); bottom: auto; }
  .op-cap:is(.cap-right, .cap-right-top, .cap-right-mid)::before { left: calc(-28 * var(--u)); transform-origin: 0 50%; }
  .op-cap:is(.cap-left, .cap-left-top, .cap-left-mid)::before { left: auto; right: calc(-28 * var(--u)); transform-origin: 100% 50%; }
  .op-cap:is(.cap-right, .cap-left, .cap-right-top, .cap-left-top, .cap-right-mid, .cap-left-mid).is-on::before { scale: 1 1; }
  .op-cap-l { display: block; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  /* sortie rapide (vers le haut), entrée posée (par le bas) : le relais d'un projet à l'autre se lit d'un seul geste */
  .op-cap-l > :not(b), .op-cap-ch { display: inline-block; translate: 0 110%; transition: none; }
  .op-cap:not(.is-on) .op-cap-l > :not(b), .op-cap:not(.is-on) .op-cap-ch { transition-delay: 0ms; }
  .op-cap.is-on .op-cap-l > :not(b), .op-cap.is-on .op-cap-ch { translate: 0 0; }
  .op-cap.is-on .op-cap-l > .op-cap-k { animation: op-cap-in 800ms cubic-bezier(.16,1,.3,1) 260ms backwards; }
