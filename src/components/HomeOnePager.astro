  .op-cap.is-on .op-cap-l > .op-cap-n { animation: op-cap-in 900ms cubic-bezier(.16,1,.3,1) 620ms backwards; }
  /* remplissage « backwards » : après l'animation, la lettre reprend son style normal (translate: 0), identique à la
     fin de l'animation ; elle ne garde pas de couche graphique (des centaines de lettres) */
  @keyframes op-cap-in { from { translate: 0 110%; opacity: 1; } to { translate: 0 0; opacity: 1; } }
  .op-cap-k { font-family: var(--mono); font-size: max(9px, calc(9 * var(--u))); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .op-cap-k i { font-style: normal; margin-left: 1.4em; color: var(--ink); }
  .op-cap b { font-family: var(--sans); font-weight: 400; font-size: calc(46 * var(--u)); letter-spacing: -0.045em; line-height: 0.98; display: flex; flex-wrap: wrap; column-gap: 0.24em; }
  .op-cap:is(.cap-right-top, .cap-left-top, .cap-right, .cap-left, .cap-right-mid, .cap-left-mid) b { font-size: calc(38 * var(--u)); }
  .op-cap:is(.cap-left, .cap-left-top, .cap-left-mid, .cap-below-r) b { justify-content: flex-end; }
  .op-cap-w { display: inline-flex; white-space: nowrap; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
  .op-cap-n { font-family: var(--sans); font-weight: 300; font-size: calc(18 * var(--u)); letter-spacing: -0.02em; color: var(--muted); }
  .op-slot.is-opening { z-index: 60; }
