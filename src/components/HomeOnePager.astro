  /* projet au centre : les autres s'estompent, sa légende monte sous la carte */
  /* projet au centre : sa photo s'allume (couleur, léger zoom) pendant que son nom s'écrit lettre à lettre dessous,
     relié à la photo par un filet qui descend ; les autres photos restent visibles, juste passées en noir et blanc */
  .op-card-media { transition: filter 900ms cubic-bezier(.16,1,.3,1); }
