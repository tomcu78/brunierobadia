---
// Page d'accueil « One pager » — reproduction de la maquette Figma
// JOSPARIS BRUNIER OBADIA (frame ONE PAGER, 5400 px = 3,75 × 1440 px).
// Toutes les cotes sont exprimées en --u (1 px de la maquette à 1440 px de large).
import { SITE, projects, offers, about } from '../data/site.js';
import clientLogos from '../data/clientLogos.json';
import { rankOf } from '../data/clientRank.js';
import sharp from 'sharp';
import { clients } from '../data/site.js';
import fs from 'node:fs';
import path from 'node:path';

// Hauteur optique de chaque logo : plus il est large, plus il est bas, pour une surface visuelle égale
const logoH = (file) => {
  try {
    const svg = fs.readFileSync(path.join(process.cwd(), 'public', file), 'utf8');
    const [, , w, h] = svg.match(/viewBox="([^"]+)"/)[1].trim().split(/[\s,]+/).map(Number);
    return Math.round(Math.max(15, Math.min(40, Math.sqrt(1300 / (w / h)))));
  } catch { return 24; }
};
import { localizePath } from '../lib/seo.js';

const { lang = 'fr' } = Astro.props;
const fr = lang === 'fr';
const L = (p) => localizePath(p, lang);

const T = fr
  ? {
      h1a: 'Créer des marques.',
      h1b: 'En bousculer d’autres.',
      sub: ['Branding, création', 'direction artistique.'],
      desc: "L'alliance singulière d'un stratège et d'un créatif. Nous concevons des marques remarquables, de la définition de leur singularité jusqu'à l'exécution de leurs campagnes, plateformes et objets éditoriaux.",
      cta1: "Parler d'un projet",
      cta2: 'Explorer le portfolio',
      projects: 'Nos projets',
      clients: 'Marques & Maisons accompagnées',
      offers: 'Nos trois offres',
      kicker: "L'agence",
      studios: 'Les Studios',
      meet: "Rencontrer l'équipe",
      discover: 'Découvrir les Studios & nos associés',
    }
  : {
      h1a: 'Creating brands.',
      h1b: 'Shaking up others.',
      sub: ['Branding, creation', 'art direction.'],
      desc: 'The rare union of a strategist and a creative director. We shape remarkable brands, from defining what makes them singular to executing their campaigns, platforms and editorial objects.',
      cta1: 'Start a project',
      cta2: 'Explore portfolio',
      projects: 'Our projects',
      clients: 'Selected Clients & Houses',
      offers: 'Our three practices',
      kicker: 'The agency',
      studios: 'The Studios',
      meet: 'Meet the team',
      discover: 'Discover the Studios & our partners',
    };

// Collage « Nos projets » : position, taille et couleur de fond exactes des 8 blocs de la maquette
// (ordre = ordre d'empilement du fichier Figma). x, y, w, h en --u.
const slots = [
  { x: 54.7, y: 0, w: 369.9, h: 280.3, bg: '#B9B2B2' },
  { x: 794.1, y: 635.5, w: 588.5, h: 445.9, bg: '#D9D9D9' },
  { x: 157.1, y: 817.9, w: 445.9, h: 588.5, bg: '#D9D9D9' },
  { x: 504.5, y: 134.4, w: 310.7, h: 435.7, bg: '#615757' },
  { x: 658.1, y: 1175, w: 435.7, h: 310.7, bg: '#615757' },
  { x: 85.9, y: 471.5, w: 495.7, h: 311.2, bg: '#E9B1B1' },
  { x: 859.2, y: 134.4, w: 495.7, h: 311.2, bg: '#E9B1B1' },
  { x: 378.4, y: 1408, w: 415.7, h: 292.5, bg: '#FFDADA' },
  // projets de grandes marques ajoutés à la suite, dans l'esprit du collage (formats et alternance de la maquette)
  { x: 830, y: 1640, w: 520, h: 293, bg: '#D9D9D9' },          // Société Générale
  { x: 120, y: 1900, w: 440, h: 311, bg: '#E9B1B1' },          // Peugeot
  { x: 600, y: 2160, w: 495, h: 278, bg: '#B9B2B2' },          // Aston Martin
];
// projets du collage : les huit de la maquette, puis trois grandes marques
const PICK = [...projects.slice(0, 8), ...['societe-generale-ensemble-tout-se-joue', 'peugeot-futureship', 'aston-martin-db4-60-ans'].map((slug) => projects.find((p) => p.slug === slug))].filter(Boolean);
// Collage « Nos projets » (ordinateur) : la composition horizontale du Figma est gardée (chaque carte à sa place,
// à gauche, au centre ou à droite, avec sa taille d'origine agrandie de 15 % autour de son centre), mais chaque
// projet a sa propre marche (dans l'ordre de lecture de la maquette) : les centres des cartes sont espacés
// régulièrement, un seul projet passe au centre à la fois, et chacun y reste le même temps, le temps de lire son nom.
const STEP = 300, GROW = 1;                                    // images à la taille de la maquette, marches serrées : rendu proche du Figma
const JITTER = [0, 8, -7, 8, 20, 8, -7, 4, -6, 8, -4];             // léger décalage ; MAD Paris (5e) plus d'espace avant lui : son nom restait trop peu de temps              // très léger décalage : l'esprit collage, sans déséquilibrer le rythme
const order0 = slots.map((s, i) => i).sort((a, b) => slots[a].y - slots[b].y || slots[a].x - slots[b].x);
const collage0 = slots.map((s, i) => {
  const k = order0.indexOf(i);
  const g = PICK[i]?.slug?.startsWith('hermes') ? 0.8 : GROW;      // Hermès (portrait très haut) : plus petit
  const w = s.w * g, h = s.h * g;
  const cx = 720 + (s.x + s.w / 2 - 720) * 0.82;                // composition resserrée vers le centre de la page
  const x = Math.min(1440 - 40 - w, Math.max(40, cx - w / 2));
  return { ...s, k, x, w, h, y: k * STEP + (JITTER[k] ?? 0) - h / 2, p: PICK[i] };   // la marche fixe le CENTRE de la carte
}).map((s, _, all) => ({ ...s, y: s.y - Math.min(...all.map((o) => o.y)) })).filter((s) => s.p);
// place du nom de chaque projet, calculée UNE fois ici et jamais changée ensuite : à côté de l'image si la place est
// libre, sinon dessous ou au-dessus ; jamais sur une autre carte (marge comprise), jamais sur le titre
const CAP_W = 300, CAP_H = 150, M = 14;
const MV = 70;                                                 // marge verticale : les cartes bougent avec le parallaxe (jusqu'à ~80)
const hit = (a, b) => a[0] < b[0] + b[2] + M && b[0] - M < a[0] + a[2] && a[1] < b[1] + b[3] + MV && b[1] - MV < a[1] + a[3];
const collageH = Math.max(...collage0.map((s) => s.y + s.h)) + 40;
const placed = [];                                            // noms déjà placés : ils restent affichés, ils ne doivent pas se chevaucher
const capOf = {};
[...collage0].sort((a, b) => a.k - b.k).forEach((s) => {
  const i = collage0.indexOf(s);
  const cands = {
    right: [s.x + s.w + 28, s.y + s.h - CAP_H, CAP_W, CAP_H],
    left: [s.x - 28 - CAP_W, s.y + s.h - CAP_H, CAP_W, CAP_H],
    'right-top': [s.x + s.w + 28, s.y, CAP_W, CAP_H],
    'left-top': [s.x - 28 - CAP_W, s.y, CAP_W, CAP_H],
    'right-mid': [s.x + s.w + 28, s.y + s.h / 2 - CAP_H / 2, CAP_W, CAP_H],
    'left-mid': [s.x - 28 - CAP_W, s.y + s.h / 2 - CAP_H / 2, CAP_W, CAP_H],
    below: [s.x, s.y + s.h + 20, CAP_W + 60, CAP_H],
    'below-r': [s.x + s.w - CAP_W - 60, s.y + s.h + 20, CAP_W + 60, CAP_H],
    above: [s.x, s.y - CAP_H - 20, CAP_W + 60, CAP_H],
  };
  const isLast = s.k === collage0.length - 1;                   // à droite du dernier : la sphère
  const tall = s.h > 440;                                       // carte haute : le nom à mi-hauteur, à côté (dessous, il sortirait de l'écran)
  const order = isLast ? ['left', 'left-mid', 'left-top', 'below', 'below-r']
    : tall ? ['right-mid', 'left-mid', 'right', 'left', 'right-top', 'left-top', 'below', 'below-r', 'above']
    : ['right', 'left', 'right-top', 'left-top', 'right-mid', 'left-mid', 'below', 'below-r', 'above'];
  const cap = order.find((k) => {
    const c = cands[k];
    return c[0] >= 10 && c[0] + c[2] <= 1430 && c[1] > 40 && !collage0.some((o, j) => j !== i && hit(c, [o.x, o.y, o.w, o.h])) && !placed.some((p) => hit(c, p));
  }) || 'below';
  placed.push(cands[cap]);
  capOf[i] = cap;
});
const collage = collage0.map((s, i) => ({ ...s, cap: capOf[i] }));
// la hauteur du collage inclut le nom placé sous la dernière carte (sinon il collerait à la section suivante)
const collageBottom = Math.max(collageH, ...collage0.map((s, i) => (capOf[i]?.startsWith('below') ? s.y + s.h + 20 + CAP_H : s.y + s.h)));
const byK = [...collage].sort((a, b) => a.k - b.k);
// trait d'encre (coordonnées de la maquette) : une courbe d'un centre de carte au suivant, dans l'ordre de lecture,
// puis le tour de la sphère finale, posée dans l'espace libre en bas à droite du collage
const ctr = (s) => [s.x + s.w / 2, s.y + s.h / 2];
const SPHERE = { x: 1262, y: 1395, r: 118 };
const inkSegs = byK.slice(1).map((s, j) => {
  const [x0, y0] = ctr(byK[j]), [x1, y1] = ctr(s);
  const dx = x1 - x0, dy = y1 - y0, bow = (j % 2 ? 1 : -1) * 0.28;
  return `M${x0.toFixed(1)} ${y0.toFixed(1)} C${(x0 + dx * 0.25 - dy * bow).toFixed(1)} ${(y0 + dy * 0.25 + dx * bow).toFixed(1)} ${(x0 + dx * 0.75 - dy * bow).toFixed(1)} ${(y0 + dy * 0.75 + dx * bow).toFixed(1)} ${x1.toFixed(1)} ${y1.toFixed(1)}`;
});
const inkRing = (() => {
  const [x0, y0] = ctr(byK[byK.length - 1]), R = SPHERE.r * 1.08, sx = SPHERE.x - R, sy = SPHERE.y;
  let d = `M${x0.toFixed(1)} ${y0.toFixed(1)} C${(x0 + 160).toFixed(1)} ${(y0 + 120).toFixed(1)} ${(sx - 120).toFixed(1)} ${(sy + 40).toFixed(1)} ${sx.toFixed(1)} ${sy.toFixed(1)}`;
  d += ` A${R.toFixed(1)} ${R.toFixed(1)} 0 1 1 ${(SPHERE.x + R).toFixed(1)} ${sy.toFixed(1)} A${R.toFixed(1)} ${R.toFixed(1)} 0 1 1 ${sx.toFixed(1)} ${sy.toFixed(1)}`;
  return d;
})();
// Boule de chaque projet = son offre (données des offres) : rouge = Création, rose = Brand transformation,
// corail = AI Endorsement. Un projet cité par plusieurs offres va à la plus spécifique (la dernière de la liste).
// Index des boules : 0 corail, 1 rose, 2 rouge.
const BALL_OF_OFFER = { creation: 2, 'brand-transformation': 1, 'la-marque-dans-les-ia': 0 };
const ballOf = (slug) => {
  const hits = offers.filter((o) => o.slug in BALL_OF_OFFER && o.caseSlugs?.includes(slug));
  return hits.length ? BALL_OF_OFFER[hits[hits.length - 1].slug] : -1;
};
// Chorégraphie d'apparition : un mouvement par carte + profondeur (vitesse d'arrivée)
const MOVES = Array(slots.length).fill('orb'); // entrée en cercle, depuis la couleur de l'offre du projet
// couleur et nom de l'offre de chaque projet (0 corail, 1 rose, 2 rouge ; -1 : aucune offre → bordeaux)
const ORB_COLOR = ['#e73530', '#e20066', '#960003'];
const offerOf = (slug) => offers.filter((o) => o.slug in BALL_OF_OFFER && o.caseSlugs?.includes(slug)).pop();
// origine du cercle : un coin différent par carte
const ORIGINS = [['0%', '100%'], ['100%', '0%'], ['100%', '100%'], ['0%', '0%']];
const DEPTHS = [0.35, 0.95, 0.55, 1.25, 0.7, 0.45, 1.05, 0.8, 0.6, 0.9, 0.5];
// vitesse de parallaxe relative (négatif = la carte remonte moins vite que la page, positif = plus vite)
const SPEEDS = [0.4, 0.6, -0.25, 0.9, 0.15, -0.45, 0.7, -0.1, 0.3, -0.3, 0.2]; // carte 1 (Balenciaga) : vitesse positive, elle reste toujours sous sa place → jamais collée au hero

// Bandeau de logos : tous les clients qui ont un logo, les plus grands d'abord, répartis en alternance sur les deux
// rangées pour que chacune commence par de très grandes marques (Samsung, Nike… puis Chanel, L'Oréal…).
const keyOf = (s) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/[^A-Z0-9]/g, '');
const seenLogo = new Set();
const ranked = [...new Set(clients.flatMap((c) => c.brands))]
  .filter((b) => clientLogos[keyOf(b)] && !seenLogo.has(clientLogos[keyOf(b)].src) && seenLogo.add(clientLogos[keyOf(b)].src))
  .sort((a, b) => rankOf(a) - rankOf(b));
// hauteur d'affichage selon les proportions du logo : un logo large est plus bas, un logo carré plus haut
const marquee = await Promise.all(ranked.map(async (b) => {
  const lg = clientLogos[keyOf(b)];
  let lh = 24, w = 100, h = 40;
  try {
    ({ width: w, height: h } = await sharp(path.join(process.cwd(), 'public', lg.src)).metadata());
    lh = Math.round(Math.max(15, Math.min(40, Math.sqrt(1300 / (w / h)))));
  } catch {}
  return { name: b, src: lg.src, dark: !!lg.dark, lh, w, h };
}));
const rowA = marquee.filter((_, i) => i % 2 === 0);
const rowB = marquee.filter((_, i) => i % 2 === 1);

const stats = about.stats.slice(0, 3);
---
<div class="op">
  <!-- HERO bordeaux -->
  <section class="op-hero">
    <div class="op-frame op-hero-in" data-hero>
      <img class="op-sphere op-sphere--corail" data-sphere="0.6" style="--s:0" src="/brand/sphere-corail-560.webp" srcset="/brand/sphere-corail-320.webp 320w, /brand/sphere-corail-400.webp 400w, /brand/sphere-corail-560.webp 560w, /brand/sphere-corail.webp 800w" sizes="(max-width: 820px) min(44vw, 200px), 17vw" alt="" width="640" height="640" fetchpriority="high" />
      <picture><source type="image/avif" srcset="/brand/sphere-rose-320.avif 320w, /brand/sphere-rose-400.avif 400w, /brand/sphere-rose-560.avif 560w, /brand/sphere-rose-800.avif 800w" sizes="(max-width: 820px) min(44vw, 200px), 17vw" /><img class="op-sphere op-sphere--rose" data-sphere="1" style="--s:1" src="/brand/sphere-rose-560.webp" srcset="/brand/sphere-rose-320.webp 320w, /brand/sphere-rose-400.webp 400w, /brand/sphere-rose-560.webp 560w, /brand/sphere-rose.webp 800w" sizes="(max-width: 820px) min(44vw, 200px), 17vw" alt="" width="640" height="640" fetchpriority="high" /></picture>
      <img class="op-sphere op-sphere--rouge" data-sphere="1.4" style="--s:2" src="/brand/sphere-rouge.svg" alt="" width="892" height="892" />

      <h1 class="op-title">
        <span class="op-title-a"><span style="--l:0">{T.h1a}</span></span>
        <span class="op-title-a"><span style="--l:1">{T.h1b}</span></span>
        <span class="op-title-b"><span style="--l:2">{T.sub[0]}</span></span>
        <span class="op-title-b"><span style="--l:3">{T.sub[1]}</span></span>
      </h1>
      <p class="op-desc">{T.desc}</p>
      <div class="op-actions">
        <a class="op-btn op-btn--fill" href={L('/contact')}>
          <span>{T.cta1}</span><i class="arw arw--diag" aria-hidden="true"></i>
        </a>
        <a class="op-btn op-btn--line" href={L('/projets')}>
          <span>{T.cta2}</span><i class="arw arw--right" aria-hidden="true"></i>
        </a>
      </div>
      <span class="op-hero-rule" aria-hidden="true"></span>
      <img class="op-hero-chevron" src="/brand/chevron-hero.svg" alt="" width="4" height="9" />
    </div>
  </section>
  {/* entrée du hero lancée dès que le hero est dans la page (sans attendre l'initialisation du reste) : même animation,
      elle commence plus tôt */}
  <script is:inline>(function(){var r=document.querySelector('.op');if(r)requestAnimationFrame(function(){requestAnimationFrame(function(){r.classList.add('is-ready');});});})();</script>

  <!-- NOS PROJETS : collage -->
  <section class="op-projects">
    <div class="op-frame">
      <h2 class="op-h2 op-projects-title" data-reveal="chars">
        <a href={L('/projets')} aria-label={T.projects}>
          {T.projects.split('').map((ch, i) => <span class="op-ch" aria-hidden="true" style={`--c:${i}`}>{ch === ' ' ? '\u00a0' : ch}</span>)}
        </a>
        <span class="op-count" aria-hidden="true">({String(collage.length).padStart(2, '0')})</span>
      </h2>
      <div class="op-pin" data-pin style={`--n:${collage.length}`}>
      <div class="op-stage" data-stage>
      <div class="op-cam" data-cam>
      <div class="op-collage" data-collage style={`--ch:${(collageBottom + 30).toFixed(1)}`}>
        <svg class="op-ink" data-ink viewBox={`0 0 1440 ${collageH}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
          {inkSegs.map((d) => <path d={d} />)}
          <path class="op-ink-ring" d={inkRing} />
        </svg>
        <div class="op-globe" data-globe aria-hidden="true" style={`--gx:${SPHERE.x};--gy:${SPHERE.y};--gr:${SPHERE.r}`}></div>
        {collage.map((s, i) => (
          <div class={`op-slot mv-${MOVES[i]} cap-${s.cap}`} data-slot data-ball={ballOf(s.p.slug)} style={`--x:${s.x};--y:${s.y};--w:${s.w};--h:${s.h};--bg:${s.bg};--i:${i};--d:${DEPTHS[i]};--sp:${SPEEDS[i]};--k:${s.k ?? i};--rd:${i % 2 ? -1 : 1};--orb:${ballOf(s.p.slug) >= 0 ? ORB_COLOR[ballOf(s.p.slug)] : '#510000'};--ox:${ORIGINS[i % 4][0]};--oy:${ORIGINS[i % 4][1]}`}>
          <a
            class="op-card"
            href={L(`/projets/${s.p.slug}`)}
            data-card
            data-label={fr ? 'Voir le projet' : 'View project'}
          >
            <span class="op-card-orb" aria-hidden="true"></span>
            <span class="op-card-media">
              <span class="op-card-inner">
              <img
                src={s.p.image}
                srcset={`${s.p.image.replace('.webp', '-800w.webp')} 800w, ${s.p.image.replace('.webp', '-1200w.webp')} 1200w, ${s.p.image.replace('.webp', '-1440w.webp')} 1440w, ${s.p.image} 1920w`}
                sizes={`(max-width: 820px) 100vw, ${(Math.max(s.w, s.h * 1.24 * 1.5) * 1.08 / 14.4).toFixed(1)}vw`}
                alt={`${s.p.client} – ${fr ? s.p.name_fr : s.p.name_en}`}
                width="1920"
                height="1280"
                loading="lazy"
                decoding="async"
              />
              {s.p.video && (
                <video
                  data-card-video
                  muted
                  loop
                  playsinline
                  preload="none"
                  width="1920"
                  height="1280"
                  aria-hidden="true"
                >
                  <source src={s.p.video} type="video/webm" />
                </video>
              )}
              </span>
            </span>
            <span class="op-card-strips" aria-hidden="true"></span>
            <span class="op-card-shade" aria-hidden="true"></span>
            <span class="op-card-veil" aria-hidden="true"></span>
            <span class="op-trace op-trace--t" aria-hidden="true"></span><span class="op-trace op-trace--r" aria-hidden="true"></span><span class="op-trace op-trace--b" aria-hidden="true"></span><span class="op-trace op-trace--l" aria-hidden="true"></span>
            <span class="op-card-type" aria-hidden="true"><span>{s.p.client}</span></span>
            <span class="op-card-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}<i>/{String(collage.length).padStart(2, '0')}</i></span>
            <span class="op-card-meta">
              <b>{s.p.client}</b>
              <span>{fr ? s.p.name_fr : s.p.name_en}</span>
            </span>
            <img class="op-card-chevron" src="/brand/chevron-up.svg" alt="" width="13" height="6" />
          </a>
          <span class="op-cap" aria-hidden="true">
            <span class="op-cap-l"><span class="op-cap-k">{[offerOf(s.p.slug)?.[fr ? 'fr' : 'en'].title, fr ? s.p.sector_fr : s.p.sector_en].filter(Boolean).join(' · ')}<i>{String(s.k + 1).padStart(2, '0')} / {String(collage.length).padStart(2, '0')}</i></span></span>
            <span class="op-cap-l"><b>{(() => { let c = 0; return s.p.client.split(' ').map((word) => <span class="op-cap-w">{[...word].map((ch) => <span class="op-cap-ch" style={`--c:${c++}`}>{ch}</span>)}</span>); })()}</b></span>
            <span class="op-cap-l"><span class="op-cap-n">{fr ? s.p.name_fr : s.p.name_en}</span></span>
          </span>
          </div>
        ))}
      </div>
      </div>
      <div class="op-credits" data-credits aria-hidden="true">
        {byK.map((s) => (
          <div class="op-credit" data-credit>
            <span class="op-credit-k"><i>{String(s.k + 1).padStart(2, '0')}</i> / {String(collage.length).padStart(2, '0')}<em>{[offerOf(s.p.slug)?.[fr ? 'fr' : 'en'].title, fr ? s.p.sector_fr : s.p.sector_en].filter(Boolean).join(' · ')}</em></span>
            <b>{(() => { let c = 0; return s.p.client.split(' ').map((word) => <span class="op-credit-w">{[...word].map((ch) => <span class="op-credit-ch" style={`--c:${c++}`}>{ch}</span>)}</span>); })()}</b>
            <span class="op-credit-n">{fr ? s.p.name_fr : s.p.name_en}</span>
          </div>
        ))}
        <div class="op-credit op-credit--end" data-credit>
          <span class="op-credit-k"><i>{String(collage.length).padStart(2, '0')}</i> {fr ? 'projets' : 'projects'}</span>
          <b><a href={L('/projets')} tabindex="-1">{fr ? 'Tous les projets' : 'All projects'}</a></b>
        </div>
        <span class="op-credits-bar" aria-hidden="true">{byK.map(() => <i />)}</span>
      </div>
      </div>
      </div>
    </div>
    <span class="op-rule op-rule--a" aria-hidden="true"></span>
  </section>

  <!-- MARQUES & MAISONS -->
  <section class="op-clients">
    <h2 class="op-h2" data-reveal>{T.clients}</h2>
    <div class="op-marquee">
      <div class="op-track">
        {[...rowA, ...rowA].map((b, i) => (
          <span class="op-logo" title={b.name} style={`--lh:${b.lh}`}><img src={b.src} alt={i < rowA.length ? b.name : ''} class={b.dark ? 'is-light' : ''} width={b.w} height={b.h} style={`aspect-ratio:${b.w}/${b.h}`} loading="lazy" decoding="async" /></span>
        ))}
      </div>
    </div>
    <div class="op-marquee op-marquee--b">
      <div class="op-track">
        {[...rowB, ...rowB].map((b, i) => (
          <span class="op-logo" title={b.name} style={`--lh:${b.lh}`}><img src={b.src} alt={i < rowB.length ? b.name : ''} class={b.dark ? 'is-light' : ''} width={b.w} height={b.h} style={`aspect-ratio:${b.w}/${b.h}`} loading="lazy" decoding="async" /></span>
        ))}
      </div>
    </div>
  </section>

  <!-- NOS TROIS OFFRES -->
  <section class="op-offers">
    <div class="op-frame">
      <h2 class="op-h2" data-reveal>{T.offers}</h2>
      <ul class="op-offer-list">
        {offers.map((o) => (
          <li data-reveal="row">
            <a class="op-offer" href={L(`/offres/${o.slug}`)}>
              <h3>{o[lang].title}</h3>
              <p>{o[lang].text}</p>
              <img class="op-offer-go" src="/brand/icon-offer-arrow.svg" alt="" width="17" height="19" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- LES STUDIOS -->
  <section class="op-studios">
    <div class="op-frame op-studios-in">
      <div class="op-studios-head" data-reveal>
        <div>
          <p class="op-kicker">{T.kicker}</p>
          <h2 class="op-studios-title">{T.studios}</h2>
        </div>
        <a class="op-kicker op-meet" href={L('/studios')}>{T.meet} →</a>
      </div>
      <p class="op-studios-text" data-reveal>{about[lang]}</p>
      <div class="op-stats" data-reveal="stats">
        {stats.map((s) => (
          <div class="op-stat">
            <div>
              <b><span data-count={s.value}>{s.value}</span>{s.value === '200' ? '+' : ''}</b>
              <span>{s.label[lang]}</span>
            </div>
          </div>
        ))}
        <div class="op-stat op-stat--empty" aria-hidden="true"></div>
      </div>
      <a class="op-btn op-btn--ink" href={L('/studios')}>
        <span>{T.discover}</span><i class="arw arw--right" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <!-- Signature jaune flottante : suit le défilement après « Nos projets » -->
  <a class="op-sig" href={L('/studios')} aria-label="BrunierObadia Studios" data-sig>
    <img class="op-sig-trio" src="/brand/sphere-jaune-256.webp" alt="" width="256" height="260" loading="lazy" decoding="async" />
    <img class="op-sig-logo" src="/brand/signature-logo.svg" alt="" width="705" height="714" loading="lazy" />
  </a>
</div>

<script>
  import { initArtistMotion } from '../scripts/artist-motion.js';
  import { initProjectsFx } from '../scripts/projects-fx.js';
  import { initCollageDepth } from '../scripts/collage-depth.js';

  // Parallaxe multi-couches du collage « Nos projets »
  // - chaque carte a sa profondeur : vitesse, rotation et inclinaison propres
  // - l'image glisse à contre-sens dans son cadre
  // - la souris incline le collage en 3D, couche par couche
  // - révélation en rideau à l'entrée, curseur « Voir le projet »
  let cleanup = null;

  function init() {
    cleanup?.();
    const collage = document.querySelector('[data-collage]');
    if (!collage) return;
    const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reduce = reduceMotion();
    const cards = [...collage.querySelectorAll('[data-card]')];
    const cursor = collage.querySelector('[data-cursor]');
    const root = collage.closest('.op');
    const hero = root?.querySelector('[data-hero]');
    let spheres = [...(root?.querySelectorAll('[data-sphere]') || [])].map((el) => ({ el, d: Number(el.dataset.sphere) || 1 }));

    // Tracé de la sphère rouge : les 900 traits du vecteur Figma se dessinent, rendu final identique
    const drawRouge = async () => {
      const img = root?.querySelector('.op-sphere--rouge');
      if (!img) return;
      try {
        const txt = await fetch(img.getAttribute('src')).then((r) => r.text());
        const svg = document.importNode(new DOMParser().parseFromString(txt, 'image/svg+xml').documentElement, true);
        for (const { name, value } of [...img.attributes]) {
          if (!['src', 'width', 'height', 'alt', 'fetchpriority', 'loading'].includes(name)) svg.setAttribute(name, value);
        }
        svg.setAttribute('aria-hidden', 'true');
        svg.removeAttribute('width'); svg.removeAttribute('height');
        img.replaceWith(svg);
        const entry = spheres.find((sp) => sp.el === img);
        if (entry) entry.el = svg;
        const vb = svg.viewBox.baseVal;
        const cx = vb.x + vb.width / 2, cy = vb.y + vb.height / 2;
        const paths = [...svg.querySelectorAll('path')];
        paths.forEach((p) => {
          const L = p.getTotalLength();
          const b = p.getBBox();
          const ang = (Math.atan2(b.y + b.height / 2 - cy, b.x + b.width / 2 - cx) + Math.PI) / (Math.PI * 2);
          p.style.strokeDasharray = `${L} ${L}`;
          p.style.strokeDashoffset = String(L);
          p.style.transition = `stroke-dashoffset 1500ms cubic-bezier(.65,0,.35,1) ${Math.round(500 + ang * 1300 + Math.random() * 350)}ms`;
        });
        svg.classList.add('op-sphere--drawn');
        requestAnimationFrame(() => requestAnimationFrame(() => paths.forEach((p) => { p.style.strokeDashoffset = '0'; })));
        setTimeout(() => {
          // tracé terminé : on remplace le SVG par l'image haute qualité du même vecteur (traits fins nets, sans grain)
          const im = document.createElement('img');
          for (const { name, value } of [...svg.attributes]) {
            if (!['viewBox', 'xmlns', 'fill', 'aria-hidden', 'width', 'height'].includes(name)) im.setAttribute(name, value);
          }
          im.alt = ''; im.width = 800; im.height = 800; im.decoding = 'async';
          im.src = '/brand/sphere-rouge-raster.webp';
          const swap = () => { svg.replaceWith(im); const e2 = spheres.find((sp) => sp.el === svg); if (e2) e2.el = im; };
          (im.decode ? im.decode() : Promise.resolve()).then(swap, swap);
        }, 4000);
      } catch {
        img.classList.add('op-sphere--fallback');
      }
    };

    // Signature jaune flottante : visible après « Nos projets », mot en clair sur les fonds bordeaux
    const sig = root?.querySelector('[data-sig]');
    const projectsSec = root?.querySelector('.op-projects');
    let sigGeo = null, sigRaf = 0, sigOn = null, sigDark = null;
    const sigMeasure = () => {
      if (!sig || !projectsSec) return null;
      const y = scrollY;
      const pr = projectsSec.getBoundingClientRect();
      return {
        projectsBottom: pr.bottom + y,
        sigH: sig.offsetHeight,
        dark: [...document.querySelectorAll('.op-offers, .site-foot')].map((el) => { const r = el.getBoundingClientRect(); return [r.top + y, r.bottom + y]; }),
      };
    };
    const sigUpdate = () => {
      sigRaf = 0;
      sigGeo ??= sigMeasure();
      if (!sigGeo) return;
      const y = scrollY, vh = innerHeight;
      const on = sigGeo.projectsBottom - y < vh * 0.85;
      const probe = y + vh - sigGeo.sigH * 0.35 - 16;
      const dark = sigGeo.dark.some(([a, b]) => a < probe && b > probe);
      if (on !== sigOn) { sigOn = on; sig.classList.toggle('is-on', on); }
      if (dark !== sigDark) { sigDark = dark; sig.classList.toggle('on-dark', dark); }
    };
    const updateSig = () => { if (!sigRaf) sigRaf = requestAnimationFrame(sigUpdate); };
    const sigReset = () => { sigGeo = null; updateSig(); };
    const sigRo = new ResizeObserver(sigReset);
    sigRo.observe(document.body);
    addEventListener('scroll', updateSig, { passive: true });
    updateSig();

    // Bandeaux de logos : défilement continu, jamais mis en pause (Safari ne relançait l'animation qu'au survol)

    // Entrée du hero
    requestAnimationFrame(() => requestAnimationFrame(() => root?.classList.add('is-ready')));

    // Compteurs 50 / 200 / 21
    const countUp = (el) => {
      const end = Number(el.dataset.count) || 0;
      const t0 = performance.now();
      const step = (t) => {
        const k = Math.min(1, (t - t0) / 1800);
        el.textContent = String(Math.round(end * (1 - Math.pow(2, -10 * k))));
        if (k < 1) requestAnimationFrame(step); else el.textContent = String(end);
      };
      el.textContent = '0';
      requestAnimationFrame(step);
    };

    // Apparitions au défilement
    const rio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        if (e.target.dataset.reveal === 'stats' && !reduceMotion()) e.target.querySelectorAll('[data-count]').forEach(countUp);
        rio.unobserve(e.target);
      });
    }, { rootMargin: '0px 0px -12% 0px' });
    root?.querySelectorAll('[data-reveal]').forEach((el) => rio.observe(el));

    // Décodage anticipé : chaque photo est chargée et décodée hors du fil principal
    // bien avant d'arriver à l'écran, pour qu'aucun décodage ne bloque l'apparition.
    const decoded = new Map();
    const preDecode = (card) => {
      if (decoded.has(card)) return decoded.get(card);
      const img = card.querySelector('.op-card-media img');
      if (!img) return Promise.resolve();
      img.loading = 'eager';
      const p = (img.decode ? img.decode() : Promise.resolve()).catch(() => {});
      decoded.set(card, p);
      return p;
    };
    const dio = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { preDecode(e.target); dio.unobserve(e.target); } });
    }, { rootMargin: '150% 0px 150% 0px' });
    // lancé une fois la page chargée : les photos du collage ne concurrencent pas l'affichage du hero,
    // et sont toujours décodées bien avant qu'on arrive à elles
    const startDecode = () => cards.forEach((c) => dio.observe(c));
    if (document.readyState === 'complete') startDecode(); else addEventListener('load', startDecode, { once: true });

    // Vidéos des cartes : une seule joue à la fois (la plus visible), les autres montrent leur image.
    // Plusieurs vidéos décodées en même temps faisaient tomber la fluidité sur les machines modestes.
    const cardVideos = [...collage.querySelectorAll('video[data-card-video]')];
    let vio = null;
    if (cardVideos.length && !reduce) {
      const seen = new Map();
      vio = new IntersectionObserver((entries) => {
        entries.forEach((e) => seen.set(e.target, e.isIntersecting ? e.intersectionRatio : 0));
        let best = null, bestR = 0.1;
        seen.forEach((r, v) => { if (r > bestR) { best = v; bestR = r; } });
        cardVideos.forEach((v) => { if (v === best) v.play().catch(() => {}); else if (!v.paused) v.pause(); });
      }, { threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] });
      cardVideos.forEach((v) => {
        v.addEventListener('playing', () => v.classList.add('is-playing'), { once: true });
        vio.observe(v);
      });
    }

    const io = { disconnect() {} }; // révélation désormais pilotée par le défilement (voir tick)

    if (reduce) { root?.querySelector('.op-sphere--rouge')?.classList.add('op-sphere--fallback'); cleanup = () => { io.disconnect(); dio.disconnect(); rio.disconnect(); sigRo.disconnect(); vio?.disconnect(); removeEventListener('scroll', updateSig); }; return; }
    drawRouge();
    // Les sphères restent en image haute qualité : rendues en SVG, leurs traits ultra-fins deviennent un grain informe à l'écran.
    const stopFx = () => {};

    const mobile = () => innerWidth <= 820;
    let raf = 0;


    // --- Mesures mises en cache (pas de lecture de mise en page à chaque image) ---
    // Sens du rideau et du voile par carte (bas, gauche, haut, droite…) et sens de rotation d'arrivée
    // Plage d'apparition de chaque carte, en pixels de la timeline « cover » (0 = haut de la carte au bas de l'écran).
    // Une carte déjà visible au chargement démarre à la position actuelle : aucune image avant de défiler.
    const slots = [...collage.querySelectorAll('[data-slot]')];
    if (mobile()) slots.forEach((s) => s.classList.add('is-revealed'));
    const vh0 = innerHeight, sy0 = scrollY, colTop0 = collage.getBoundingClientRect().top + sy0;
    const ranges = slots.map((slot) => {
      const h = slot.offsetHeight;
      const coverStart = colTop0 + slot.offsetTop - vh0;            // défilement où le haut de la carte touche le bas de l'écran
      const start = Math.max(0, sy0 - coverStart + 2);
      const end = Math.max(h * 0.25 + vh0 * 0.32, start + vh0 * 0.3); // photo entière dès le tiers bas de l'écran
      slot.style.setProperty('--rs', `cover ${start.toFixed(0)}px`);
      slot.style.setProperty('--re', `cover ${end.toFixed(0)}px`);
      return { slot, start, end, lockRel: coverStart + end - colTop0 };
    });

    // Lamelles : 5 bandes, chacune avec une copie exacte du contenu de la carte recadrée sur sa hauteur (animation en CSS).
    // Mise en scène : elles arrivent après le tracé du cadre (à partir de 18 % de la plage).
    const NSTRIPS = 5;
    ranges.filter(({ slot }) => slot.classList.contains('mv-strips')).forEach(({ slot, start, end }) => {
      const wrap = slot.querySelector('.op-card-strips'), inner = slot.querySelector('.op-card-inner');
      if (!wrap || !inner) return;
      const span = end - start;
      // les éléments créés en JS doivent porter le marqueur de style du composant, sinon les styles scopés ne s'appliquent pas
      const cid = [...slot.attributes].find((at) => at.name.startsWith('data-astro-cid'))?.name;
      for (let j = 0; j < NSTRIPS; j++) {
        const band = document.createElement('span');
        band.className = `op-strip ${j % 2 ? 'is-r' : 'is-l'}`;
        const bs = start + span * (0.18 + j * 0.06), be = start + span * Math.min(0.92, 0.6 + j * 0.08);
        band.style.cssText = `top:${(j * 100) / NSTRIPS}%;height:${100 / NSTRIPS}%;animation-range:cover ${bs.toFixed(0)}px cover ${be.toFixed(0)}px`;
        const plate = document.createElement('span');
        plate.className = 'op-strip-plate';
        plate.style.cssText = `top:${-j * 100}%;height:${NSTRIPS * 100}%`;
        const clone = inner.cloneNode(true);
        clone.querySelectorAll('video').forEach((v) => v.remove());
        clone.querySelectorAll('img').forEach((im) => { im.style.animation = 'none'; });
        plate.appendChild(clone);
        if (cid) { band.setAttribute(cid, ''); plate.setAttribute(cid, ''); }
        band.appendChild(plate);
        wrap.appendChild(band);
      }
    });

    // Apparition jouée une seule fois : quand le défilement dépasse la fin de sa plage, on retire ses animations
    // d'apparition (état final identique). Le parallaxe continue.
    let lockRaf = 0;
    const checkLocks = () => {
      lockRaf = 0;
      // position du collage relue en direct : la séquence épinglée du hero décale la page
      const y = scrollY - (collage.getBoundingClientRect().top + scrollY);
      for (const r of ranges) {
        if (r.done || y < r.lockRel) continue;
        r.done = true;
        r.slot.classList.add('is-revealed');
        r.slot.querySelectorAll('.op-strip').forEach((b) => b.remove());
      }
    };
    const onLockScroll = () => { if (!lockRaf) lockRaf = requestAnimationFrame(checkLocks); };
    addEventListener('scroll', onLockScroll, { passive: true });
    const doneIo = { disconnect() { removeEventListener('scroll', onLockScroll); } };

    let collageTop = 0, collageH = 0, heroTop = 0, heroLeft = 0, heroW = 0, heroH = 0;
    const sphereRest = new Map(); // élément → centre au repos (coordonnées du hero) + rayon
    const measure = () => {
      const sy = scrollY;
      const cr = collage.getBoundingClientRect();
      collageTop = cr.top + sy; collageH = cr.height;
      if (hero) {
        const hr = hero.getBoundingClientRect();
        heroTop = hr.top + sy; heroLeft = hr.left; heroW = hero.clientWidth; heroH = hero.clientHeight;
        spheres.forEach((sp) => {
          // centre réel à l'écran, moins le décalage d'animation en cours (la rotation et l'échelle ne bougent pas le centre)
          const el = sp.el;
          if (el.style.position === 'fixed') return; // boule en voyage (artist-motion) : on garde sa position de repos
          const r = el.getBoundingClientRect();
          const hx = parseFloat(el.style.getPropertyValue('--hx')) || 0;
          const hy = parseFloat(el.style.getPropertyValue('--hy')) || 0;
          const w = el.clientWidth || r.width;
          sphereRest.set(sp.key, { x: r.left + r.width / 2 - hr.left - hx, y: r.top + r.height / 2 - hr.top - hy, R: w / 2 });
        });
      }
    };
    spheres.forEach((sp, i) => {
      sp.key = i;
      sp.mx = 0; sp.my = 0; sp.vx = 0; sp.vy = 0; sp.ms = 1; sp.k = 0;
      sp.ang = i * 40;
      sp.speed = [4, -5.2, 3.3][i] || 4;           // degrés par seconde (rotation au repos)
      sp.ph = [0, 2.1, 4.3][i] || 0;              // décalage de phase du flottement
    });
    measure();
    const ro = new ResizeObserver(() => measure());
    ro.observe(document.body);

    // Survol du collage : seule la carte survolée reste en couleur
    const onOver = (e) => collage.classList.toggle('has-hover', !!e.target.closest('[data-card]'));
    const onLeave = () => collage.classList.remove('has-hover');
    collage.addEventListener('pointerover', onOver);
    collage.addEventListener('pointerleave', onLeave);

    const hm = { x: 0, y: 0, tx: 0, ty: 0, cx: -1e4, cy: -1e4 };
    const onHeroMove = (e) => { hm.cx = e.clientX; hm.cy = e.clientY; hm.tx = e.clientX / innerWidth - 0.5; hm.ty = (e.clientY - (heroTop - scrollY)) / (hero?.clientHeight || 1) - 0.5; };
    const onHeroLeave = () => { hm.tx = 0; hm.ty = 0; hm.cx = -1e4; hm.cy = -1e4; };
    hero?.addEventListener('pointermove', onHeroMove);
    hero?.addEventListener('pointerleave', onHeroLeave);

    const lastHit = new Map();

    let last = performance.now();
    const tick = (time) => {
      const dt = Math.min(0.05, (time - last) / 1000); last = time;
      const t = time / 1000;
      const vh = innerHeight;
      const sy = scrollY;
      const isMobile = mobile();

      // --- Sphères : flottement passif, respiration, rotation, magnétisme ---
      const heroScreenTop = heroTop - sy;
      if (hero && spheres.length && heroScreenTop + heroH > 0) {
        hm.x += (hm.tx - hm.x) * 0.05;
        hm.y += (hm.ty - hm.y) * 0.05;
        const U = isMobile ? 0.6 : Math.min(innerWidth, 1680) / 1440;
        const F = dt * 60; // normalise sur 60 images/s
        const W = heroW || innerWidth, H = heroH || 500;
        // 1) forces : dérive, rappel élastique vers la maquette, souris
        for (const sp of spheres) {
          const rest = sphereRest.get(sp.key);
          if (!rest) continue;
          sp.th = (sp.th ?? sp.ph) + (Math.sin(t * 0.4 + sp.ph * 3) * 0.6 + (Math.random() - 0.5)) * 0.025 * F;
          let ax = Math.cos(sp.th) * 0.02 * U, ay = Math.sin(sp.th) * 0.016 * U;
          ax -= sp.mx * 0.00016; ay -= sp.my * 0.0002;                 // élastique vers la position Figma
          const cx = heroLeft + rest.x + sp.mx, cy = heroScreenTop + rest.y + sp.my;
          const dx = hm.cx - cx, dy = hm.cy - cy, dm = Math.hypot(dx, dy) || 1;
          const kk = Math.max(0, 1 - dm / (rest.R * 2.2));
          const ease = kk * kk * (3 - 2 * kk);
          sp.k += (ease - sp.k) * 0.06;
          ax += (dx / dm) * ease * 0.22 * U; ay += (dy / dm) * ease * 0.22 * U; // attirée par le curseur
          sp.vx = (sp.vx + ax * F) * Math.pow(0.978, F);
          sp.vy = (sp.vy + ay * F) * Math.pow(0.978, F);
          const v = Math.hypot(sp.vx, sp.vy), vmax = 1.1 * U;
          if (v > vmax) { sp.vx *= vmax / v; sp.vy *= vmax / v; }
          sp.mx += sp.vx * F; sp.my += sp.vy * F;
          // bords du hero (rebond amorti)
          const x = rest.x + sp.mx, y = rest.y + sp.my, r = rest.R * 0.6;
          if (x < r) { sp.mx += r - x; sp.vx = Math.abs(sp.vx) * 0.8; }
          if (x > W - r) { sp.mx -= x - (W - r); sp.vx = -Math.abs(sp.vx) * 0.8; }
          if (y < r * 0.4) { sp.my += r * 0.4 - y; sp.vy = Math.abs(sp.vy) * 0.8; }
          if (y > H - r * 0.4) { sp.my -= y - (H - r * 0.4); sp.vy = -Math.abs(sp.vy) * 0.8; }
        }
        // 2) collisions entre sphères
        for (let i = 0; i < spheres.length; i++) {
          for (let j = i + 1; j < spheres.length; j++) {
            const A = spheres[i], B = spheres[j];
            const ra = sphereRest.get(A.key), rb = sphereRest.get(B.key);
            if (!ra || !rb) continue;
            const dx = (rb.x + B.mx) - (ra.x + A.mx), dy = (rb.y + B.my) - (ra.y + A.my);
            const d = Math.hypot(dx, dy) || 1, minD = (ra.R * A.ms + rb.R * B.ms) * 0.9;
            if (d >= minD) continue;
            const nx = dx / d, ny = dy / d, overlap = (minD - d) / 2;
            A.mx -= nx * overlap; A.my -= ny * overlap; B.mx += nx * overlap; B.my += ny * overlap;
            const rel = (B.vx - A.vx) * nx + (B.vy - A.vy) * ny;
            if (rel < 0) {
              const imp = -rel * 0.92; // restitution
              A.vx -= nx * imp; A.vy -= ny * imp; B.vx += nx * imp; B.vy += ny * imp;
              const kick = Math.min(20, -rel * 14);
              A.spin = (A.spin || 0) + kick; B.spin = (B.spin || 0) - kick;
              // déformation légère : la sphère s'écrase un peu dans l'axe du choc puis rebondit (balle souple)
              const key = i * 10 + j;
              if (time - (lastHit.get(key) || 0) > 400) {
                lastHit.set(key, time);
                const amt = Math.min(0.05, 0.022 + -rel * 0.025);
                const n = Math.atan2(ny, nx);
                A.sqN = n; B.sqN = n; A.sq = amt; B.sq = amt; A.sqv = 0; B.sqv = 0;
              }
            }
          }
        }
        // 3) rendu
        for (const sp of spheres) {
          const breathe = 1 + Math.sin(t * 0.9 + sp.ph) * 0.035;
          sp.ms += (breathe + 0.07 * sp.k - sp.ms) * 0.1;
          sp.spin = (sp.spin || 0) * Math.pow(0.96, F);
          // ressort de la déformation : quelques petites oscillations puis retour à la forme ronde
          if (sp.sq) {
            sp.sqv = ((sp.sqv || 0) - sp.sq * 0.2 * F) * Math.pow(0.8, F);
            sp.sq += sp.sqv * F;
            if (Math.abs(sp.sq) < 0.0008 && Math.abs(sp.sqv) < 0.0008) sp.sq = 0;
          }
          sp.ang += (sp.speed * (1 + sp.k * 4) + sp.spin) * dt;
          const st = sp.el.style;
          st.setProperty('--hx', (sp.mx + hm.x * 30 * sp.d).toFixed(1) + 'px');
          st.setProperty('--hy', (sp.my + hm.y * 22 * sp.d).toFixed(1) + 'px');
          st.setProperty('--ms', sp.ms.toFixed(4));
          // écrasement dans l'axe du choc, exprimé dans le repère de l'écran (compense la rotation de la sphère)
          if (sp.sq) {
            const a = (sp.sqN * 180 / Math.PI - sp.ang).toFixed(2);
            st.transform = `rotate(${a}deg) scale(${(1 - sp.sq).toFixed(4)}, ${(1 + sp.sq * 0.6).toFixed(4)}) rotate(${-a}deg) scale(${sp.ms.toFixed(4)})`;
          } else if (st.transform) st.transform = '';
          st.rotate = sp.ang.toFixed(2) + 'deg';
          const rest = sphereRest.get(sp.key);
          // pose lue par artist-motion (docY : position dans la page, indépendante du moment où le défilement est lu)
          if (rest) sp.el._pose = { cx: heroLeft + rest.x + sp.mx + hm.x * 30 * sp.d, cy: heroScreenTop + rest.y + sp.my + hm.y * 22 * sp.d, docY: heroTop + rest.y + sp.my + hm.y * 22 * sp.d, w: rest.R * 2, ms: sp.ms, ang: sp.ang };
        }
      }
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    cleanup = () => {
      cancelAnimationFrame(raf);
      doneIo.disconnect();
      io.disconnect();
      dio.disconnect();
      vio?.disconnect();
      rio.disconnect();
      removeEventListener('scroll', updateSig);
     
      sigRo.disconnect();
      stopFx();
      ro.disconnect();
      hero?.removeEventListener('pointermove', onHeroMove);
      hero?.removeEventListener('pointerleave', onHeroLeave);
      collage.removeEventListener('pointerleave', onLeave);
      collage.removeEventListener('pointerover', onOver);
      cleanup = null;
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());

  // Mise en mouvement GSAP (hero, sphères voyageuses, projets, marques, offres, studios)
  let artCleanup = null;
  document.addEventListener('astro:page-load', () => { artCleanup?.(); artCleanup = initArtistMotion(document.querySelector('.op')); });
  document.addEventListener('astro:before-swap', () => { artCleanup?.(); artCleanup = null; });

  // (profondeur physique du collage retirée : le récit épinglé de « Nos projets » la remplace sur ordinateur)

  // « Nos projets » : le fil d'encre qui relie les projets, le projet au centre et son nom, l'ouverture au clic
  let fxCleanup = null;
  document.addEventListener('astro:page-load', () => { fxCleanup?.(); fxCleanup = initProjectsFx(document.querySelector('[data-collage]')); });
  document.addEventListener('astro:before-swap', () => { fxCleanup?.(); fxCleanup = null; });
  // profondeur douce du collage (suit un peu la souris)
  let depthCleanup = null;
  document.addEventListener('astro:page-load', () => { depthCleanup?.(); depthCleanup = initCollageDepth(document.querySelector('[data-collage]')); });
  document.addEventListener('astro:before-swap', () => { depthCleanup?.(); depthCleanup = null; });
</script>

<style>
