  .op-rule { display: block; height: 1px; background: var(--rule); width: calc(1012.8 * var(--u)); margin: 0 auto; position: relative; left: calc(-12.8 * var(--u)); }
  .op-rule--a { margin-top: calc(105.6 * var(--u)); }

  /* ---------- MARQUES ---------- */
  .op-clients { padding-top: calc(35.5 * var(--u)) !important; color: var(--ink); }
  .op-clients .op-h2 { margin-bottom: calc(60 * var(--u)); }
  .op-marquee { overflow: hidden; height: calc(46 * var(--u)); min-height: 40px; }
  .op-marquee--b { margin-top: calc(46 * var(--u)); margin-bottom: calc(111 * var(--u)); }
  /* l'écart est une marge à droite de chaque logo (pas un gap) : la bande vaut exactement deux fois la série,
     le recul de 50 % retombe pile sur le début de la copie, sans saut à chaque tour */
  .op-track { display: flex; align-items: center; width: max-content; height: 100%; animation: op-scroll 240s linear infinite; }
  .op-marquee--b .op-track { animation-duration: 260s; } /* même sens que la 1re rangée : les grandes marques arrivent d'abord */
  .op-track { will-change: transform; }
  .op-logo { flex: none; height: 100%; margin-right: calc(110 * var(--u)); display: flex; align-items: center; font-family: var(--mono); font-size: max(10px, calc(12 * var(--u))); letter-spacing: 0.12em; color: var(--muted); }
  /* hauteur optique propre à chaque logo (--lh, calculée au build) : surfaces visuelles équivalentes */
  .op-logo img { height: calc(var(--lh, 24) * var(--u)); min-height: 14px; width: auto; max-width: none; object-fit: contain; transition: transform 300ms cubic-bezier(.16,1,.3,1); }
  .op-logo:hover img { transform: scale(1.08); }
  .op-logo img.is-light { filter: brightness(0); } /* logos blancs prévus pour fond sombre */
  @keyframes op-scroll { to { transform: translateX(-50%); } }
  .op-rule--b { margin-top: calc(105 * var(--u)); }

  /* ---------- OFFRES ---------- */
  .op-offers { background: var(--bordeaux); color: #fff; margin-top: calc(-4.8 * var(--u)); padding: calc(71 * var(--u)) 0 calc(129.6 * var(--u)) !important; }
  .op-offer-list { list-style: none; margin: calc(70.4 * var(--u)) 0 0 calc(190.9 * var(--u)); padding: 0; width: calc(1109.6 * var(--u)); }
  .op-offer-list li + li { margin-top: calc(34.4 * var(--u)); }
  .op-offer {
    position: relative;
    display: grid;
    grid-template-columns: calc(559 * var(--u)) calc(490 * var(--u)) 1fr;
    align-items: start;
    padding: 0 0 calc(20 * var(--u)) calc(12.8 * var(--u));
    min-height: calc(66.4 * var(--u));
