  .op-studios .op-btn--ink { margin-top: calc(24.4 * var(--u)); position: relative; z-index: 2; background: rgba(255, 255, 255, 0.6); }


  /* ---------- ANIMATIONS ---------- */
  /* Hero : lignes du titre qui sortent d'un masque */
  .op-title-a, .op-title-b { overflow: hidden; padding-top: 0.14em; margin-top: -0.14em; }
  .op-title > span > span { transform: translate3d(0, 115%, 0) skewY(4deg); transition: transform 1300ms cubic-bezier(.16,1,.3,1) calc(250ms + var(--l) * 110ms); }
  .op.is-ready .op-title > span > span { transform: none; }
  .op-desc, .op-actions, .op-hero-rule, .op-hero-chevron { opacity: 0; translate: 0 18px; transition: opacity 1000ms ease 850ms, translate 1200ms cubic-bezier(.16,1,.3,1) 850ms; }
  .op-actions { transition-delay: 1000ms; }
  .op-hero-rule { transform-origin: left; scale: 0 1; translate: 0; transition: scale 1400ms cubic-bezier(.77,0,.18,1) 1100ms, opacity 400ms ease 1100ms; }
  .op.is-ready :is(.op-desc, .op-actions, .op-hero-chevron) { opacity: 1; translate: 0 0; }
  .op.is-ready .op-hero-rule { opacity: 1; scale: 1 1; }

  /* Sphères : apparition, rotation lente, suivi souris + scroll */
  /* Couche graphique dédiée : la sphère est dessinée une fois en haute qualité à sa taille réelle,
     puis déplacée / tournée / agrandie par la carte graphique (lissage, aucune pixelisation).
     L'entrée est un fondu à taille réelle : aucune réduction qui figerait une basse résolution. */
  .op-sphere {
    /* 0,01 et non 0 : invisible sur le bordeaux, mais la boule est « peinte » dès son chargement (les outils de mesure
       ne comptent pas un élément à opacité nulle : sans cela l'affichage paraissait attendre la fin du fondu) */
    opacity: 0.01;
    translate: calc(var(--hx, 0px) * var(--hk, 1) + var(--tx, 0px)) calc(var(--hy, 0px) * var(--hk, 1) + var(--ty, 0px));
    scale: var(--ts, 1);
    transition: opacity 1600ms ease calc(200ms + var(--s) * 180ms);
    will-change: transform, translate, rotate;
  }
  .op.is-ready .op-sphere { opacity: 1; }
  .op-sphere { transform: scale(var(--ms, 1)); }
  .op.is-ready .op-sphere--rouge:not(.op-sphere--drawn):not(.op-sphere--fallback) { opacity: 0; }
  .op-sphere--drawn { opacity: 1; transition: none; overflow: visible; }
  @keyframes op-spin { to { rotate: 360deg; } }

  /* « Nos projets » : lettres qui montent une à une, vague au survol */
  .op-ch { display: inline-block; transform: translate3d(0, 110%, 0) rotate(10deg); opacity: 0; transition: transform 1000ms cubic-bezier(.16,1,.3,1) calc(var(--c) * 40ms), opacity 700ms ease calc(var(--c) * 40ms); }
  .is-in .op-ch { transform: none; opacity: 1; }
  .op-projects-title a:hover .op-ch { animation: op-wave 700ms cubic-bezier(.16,1,.3,1) calc(var(--c) * 30ms); }
  @keyframes op-wave { 40% { transform: translate3d(0, -22%, 0); color: var(--bordeaux); } }
  .op-count { display: inline-block; vertical-align: top; margin-left: 6px; font-family: var(--mono); font-size: max(9px, calc(9 * var(--u))); letter-spacing: 0.1em; color: var(--muted); opacity: 0; translate: 0 6px; transition: opacity 600ms ease 600ms, translate 800ms cubic-bezier(.16,1,.3,1) 600ms; }
  .is-in .op-count { opacity: 1; translate: 0 0; }

  /* Apparitions génériques au défilement */
  [data-reveal]:not([data-reveal="chars"]) { opacity: 0; translate: 0 40px; transition: opacity 1000ms ease, translate 1300ms cubic-bezier(.16,1,.3,1); }
  [data-reveal].is-in { opacity: 1; translate: 0 0; }
  .op-offer-list li:nth-child(1) { --rd: 0ms; } .op-offer-list li:nth-child(2) { --rd: 120ms; transition-delay: 120ms; }
  .op-offer-list li:nth-child(3) { --rd: 240ms; transition-delay: 240ms; } .op-offer-list li:nth-child(4) { --rd: 360ms; transition-delay: 360ms; }
  .op-studios-text { transition-delay: 150ms; }

  @media (prefers-reduced-motion: reduce) {
    .op-title > span > span, .op-ch, [data-reveal], .op-desc, .op-actions, .op-hero-rule, .op-hero-chevron, .op-sphere, .op-count { transform: none !important; translate: none !important; scale: none !important; opacity: 1 !important; animation: none !important; transition: none !important; }
    .op-offer::after { transform: none; }
  }


  /* ---------- Signature flottante ---------- */
  .op-sig {
    position: fixed; left: clamp(12px, 1.6vw, 24px); bottom: clamp(12px, 1.6vw, 24px); z-index: 90;
    width: clamp(78px, 7.6vw, 112px); aspect-ratio: 705 / 714;
    opacity: 0; translate: 0 24px; scale: 0.9; pointer-events: none;
