    /* les animations au défilement de l'ancien collage sont coupées : le récit pilote tout */
    .op-projects.is-stage .op-slot, .op-projects.is-stage .op-slot * { animation: none !important; }
    .op-projects.is-stage .op-slot :is(.op-card-strips, .op-card-shade, .op-card-veil, .op-trace, .op-card-type, .op-card-index, .op-cap) { display: none !important; }
