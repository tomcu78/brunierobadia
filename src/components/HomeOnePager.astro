  .op-btn--line:hover { border-color: #fff; color: #fff; }
  .op-btn--ink { min-width: calc(297 * var(--u)); height: calc(38.6 * var(--u)); border-color: var(--ink); color: var(--ink); font-family: var(--sans); font-size: max(9px, calc(8.9 * var(--u))); }
  
  .op-btn--ink:hover { background: var(--ink); color: #fff; }

  /* ---------- NOS PROJETS : collage en parallaxe multi-couches ---------- */
  .op-projects { padding-top: calc(78.4 * var(--u)) !important; overflow: clip; }
  .op-projects-title { position: absolute; left: 0; right: 0; top: calc(3.7 * var(--u)); z-index: 50; }
  .op-projects-title a { display: inline-block; overflow: hidden; padding: 0.08em 0.02em 0.12em; vertical-align: top; }
  .op-collage { z-index: 1; position: relative; height: calc(var(--ch) * var(--u)); }

  /* Titre géant en fond, défile à l'horizontale */

  /* ===== Récit épinglé (ordinateur, voir projects-stage.js) ===== */
  .op-ink, .op-globe, .op-credits { display: none; }
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
