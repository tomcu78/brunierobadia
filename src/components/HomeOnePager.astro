  @keyframes op-trace-l { 0%, 24% { opacity: 1; transform: scaleY(0); } 36% { transform: scaleY(1); } 80% { opacity: 1; } 100% { opacity: 0; transform: scaleY(1); } }
  @keyframes op-type { 0%, 30% { translate: 0 110%; } 48%, 64% { translate: 0 0; } 82%, 100% { translate: 0 -110%; } }
  @keyframes op-index { 0%, 12% { opacity: 0; translate: 0 12px; } 30%, 70% { opacity: 1; translate: 0 0; } 88%, 100% { opacity: 0; translate: 0 0; } }
  .op-card-media :is(img, video) {
    position: absolute; left: 0; top: -12%; width: 100%; height: 124%;
    object-fit: cover;
    /* la photo ou vidéo elle-même ne bouge plus : son parallaxe est porté par .op-card-inner (une couche de moins) */
    transition: scale 900ms cubic-bezier(.16,1,.3,1), filter 600ms ease;
