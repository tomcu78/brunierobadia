    .op-projects.is-stage .op-globe {
      display: block; position: absolute; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 300ms ease;
      left: calc((var(--gx) - var(--gr)) * var(--u)); top: calc((var(--gy) - var(--gr)) * var(--u));
      width: calc(var(--gr) * 2 * var(--u)); height: calc(var(--gr) * 2 * var(--u));
    }
    .op-globe :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
    /* générique : bandeau fixe en bas de la scène, le nom du projet s'y écrit toujours au même endroit */
    .op-projects.is-stage .op-credits {
      display: block; position: absolute; left: 0; right: 0; bottom: 0; height: 118px; z-index: 40;
      background: var(--paper, #fff); border-top: 1px solid var(--rule, #e3e3dc);
    }
    .op-credit { position: absolute; left: calc(54 * var(--u)); right: calc(54 * var(--u)); bottom: 20px; display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; align-items: end; column-gap: 40px; row-gap: 6px; pointer-events: none; }
    .op-credit.is-on { pointer-events: auto; }
    .op-credit b { grid-column: 1; grid-row: 1; display: flex; flex-wrap: nowrap; column-gap: 0.24em; overflow: hidden; font-family: var(--sans); font-weight: 400; font-size: clamp(28px, 2.7vw, 44px); letter-spacing: -0.045em; line-height: 0.95; color: var(--ink); }
    .op-credit b a { color: inherit; text-decoration: none; }
    .op-credit-n { grid-column: 1; grid-row: 2; align-self: start; font-family: var(--sans); font-weight: 300; font-size: clamp(14px, 1.1vw, 18px); letter-spacing: -0.02em; color: var(--muted); }
    .op-credit-k { grid-column: 2; grid-row: 2; justify-self: end; align-self: end; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    .op-credit-k i { font-style: normal; color: var(--ink); }
    .op-credit-k em { font-style: normal; margin-left: 2em; }
    .op-credit-w { display: inline-flex; overflow: hidden; padding-bottom: 0.12em; margin-bottom: -0.12em; }
    /* sortie : le nom file vers le haut et s'efface ; entrée : lettres qui montent une à une, puis titre et repères */
    .op-credit-ch, .op-credit b a { display: inline-block; translate: 0 -105%; opacity: 0; transition: translate 380ms cubic-bezier(.7,0,.84,0), opacity 260ms ease; }
    .op-credit-n, .op-credit-k { opacity: 0; translate: 0 8px; transition: opacity 240ms ease, translate 380ms cubic-bezier(.7,0,.84,0); }
    .op-credit.is-on .op-credit-ch, .op-credit.is-on b a { animation: op-credit-in 900ms cubic-bezier(.16,1,.3,1) calc(80ms + var(--c, 0) * 24ms) both; translate: 0 0; opacity: 1; transition: none; }
    .op-credit.is-on .op-credit-n { opacity: 1; translate: 0 0; transition: opacity 600ms ease 380ms, translate 900ms cubic-bezier(.16,1,.3,1) 380ms; }
    .op-credit.is-on .op-credit-k { opacity: 1; translate: 0 0; transition: opacity 600ms ease 260ms, translate 900ms cubic-bezier(.16,1,.3,1) 260ms; }
    @keyframes op-credit-in { from { translate: 0 105%; opacity: 1; } to { translate: 0 0; opacity: 1; } }
    /* repère d'avancée : 8 traits, celui du projet courant s'allume */
    .op-credits-bar { position: absolute; right: calc(54 * var(--u)); top: 18px; display: flex; gap: 6px; }
    .op-credits-bar i { width: 18px; height: 1px; background: var(--rule, #e3e3dc); transition: background 500ms ease; }
    .op-credits-bar i.is-on { background: var(--ink); }
  }

  /* Emplacement : position exacte de la maquette ; porte le parallaxe (défilement) */
  .op-slot {
    position: absolute;
    left: calc(var(--x) * var(--u));
    top: calc(var(--y) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    z-index: calc(1 + var(--k, var(--i)));        /* empilement fixe, dans l'ordre de lecture : chaque projet posé sur le précédent */
  }
  /* Carte : porte l'apparition (plus d'inclinaison 3D à la souris : elle créait des dizaines de calques 3D, trop lourd) */
  .op-card {
    position: absolute; inset: 0;
    display: block;
    overflow: hidden;
    transition: box-shadow 600ms ease;
  }
  /* Apparition pilotée par le défilement (valeurs écrites en JS). Sans JS : état final, tout visible. */
  .op-card-media { position: absolute; inset: 0; overflow: hidden; background: var(--bg); }
  .op-card-inner { position: absolute; inset: 0; scale: 1.08; }
  .op-collage-end { position: absolute; left: 0; bottom: 0; width: 1px; height: 1px; pointer-events: none; }

  /* ===== Parallaxe + apparition, calculés par le navigateur (synchrones avec la molette, aucun calcul JS) =====
     - Parallaxe continu, uniquement dans la section : l'emplacement monte/descend selon sa profondeur (--d),
       position exacte de la maquette quand la carte est au centre de l'écran ; la photo glisse à contre-sens.
     - Apparition : chorégraphie par carte (lamelles, bloc, dépliage, iris) + typo, jouée une seule fois
       (.is-revealed retire ces animations une fois la carte au centre : état final identique). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .op-collage { view-timeline: --collage block; }
      .op-slot { view-timeline: --card block; }

      /* 1) animations (raccourcis sans timeline) */
      .op-slot { animation: op-parallax linear both; }
      .op-slot .op-card-media :is(img, video) { animation: op-counter linear both; }
      .op-slot:not(.is-revealed) .op-card { animation: op-arrive cubic-bezier(.16, 1, .3, 1) both; }
      .op-slot:not(.is-revealed) .op-card-inner { animation: op-zoom cubic-bezier(.16, 1, .3, 1) both; }
      .op-slot:not(.is-revealed) .op-card-type > span { animation: op-type linear both; }
      .op-slot:not(.is-revealed) .op-card-index { animation: op-index linear both; }
      .op-slot:not(.is-revealed) .op-trace--t { animation: op-trace-t linear both; }
      .op-slot:not(.is-revealed) .op-trace--r { animation: op-trace-r linear both; }
      .op-slot:not(.is-revealed) .op-trace--b { animation: op-trace-b linear both; }
      .op-slot:not(.is-revealed) .op-trace--l { animation: op-trace-l linear both; }
      .op-slot.mv-strips:not(.is-revealed) .op-card-media { opacity: 0; }
      .op-slot.mv-strips:not(.is-revealed) .op-card-strips { visibility: visible; }
      .op-slot:not(.is-revealed) .op-strip { animation: op-band-l cubic-bezier(.77, 0, .18, 1) both; }
      .op-slot:not(.is-revealed) .op-strip.is-r { animation-name: op-band-r; }
      .op-slot.mv-block:not(.is-revealed) .op-card-veil { animation: op-block linear both; }
      .op-slot.mv-block:not(.is-revealed) .op-card-media { animation: op-block-media linear both; }
      .op-slot.mv-block:not(.is-revealed) .op-card-inner { animation-name: op-block-inner; }
      .op-slot.mv-unfold:not(.is-revealed) :is(.op-card-media, .op-card-shade) { transform-origin: 50% 0; animation: op-unfold cubic-bezier(.16, 1, .3, 1) both; }
      .op-slot.mv-unfold:not(.is-revealed) .op-card-shade { animation-name: op-unfold-shade; }
      .op-slot.mv-iris:not(.is-revealed) .op-card-media { animation: op-iris linear both; }
      .op-slot.mv-orb:not(.is-revealed) .op-card-orb { animation: op-orb-disk linear both; }
      .op-slot.mv-orb:not(.is-revealed) .op-card-media { animation: op-orb-media linear both; }
      .op-slot.mv-iris:not(.is-revealed) .op-card-inner { animation: op-iris-inner linear both; }
      .op-slot, .op-slot .op-card-media :is(img, video) { will-change: transform; }
      .op-slot:not(.is-revealed) :is(.op-card, .op-card-media, .op-card-inner, .op-card-veil, .op-strip, .op-card-type > span) { will-change: transform, translate, scale, opacity; }

      /* 2) timelines et plages dans des règles distinctes (le minifieur ne peut pas les fusionner dans le raccourci) */
      .op-collage > .op-slot, .op-slot .op-card-media :is(img, video) { animation-timeline: --card; animation-range: cover 0% cover 100%; }
      .op-slot:not(.is-revealed) :is(.op-card, .op-card-inner, .op-card-type > span, .op-card-index, .op-card-veil, .op-card-media, .op-card-shade, .op-strip, .op-trace, .op-card-orb) {
        animation-timeline: --card;
        animation-range: var(--rs, entry 0%) var(--re, cover 50%);
      }
      .op-slot.mv-block:not(.is-revealed) .op-card-inner { animation-timeline: --card; animation-range: var(--rs, entry 0%) var(--re, cover 50%); }
    }
  }
  /* ===== Mise en scène (sur la plage d'apparition de chaque carte) =====
     0–35 % : la carte apparaît en fondu et le tracé bordeaux dessine son cadre, encore vide
     18–90 % : le mouvement propre à la carte remplit le cadre avec la photo
     30–80 % : le nom du client passe dans un masque ; 80–100 % : le cadre s'efface, la carte se pose */
  @keyframes op-parallax {
    from { transform: translate3d(0, calc(var(--sp) * 90px), 0); }
    50% { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, calc(var(--sp) * -90px), 0); }
  }
  /* entrée en cercle : la couleur de l'offre s'ouvre depuis un coin, la photo suit dans le même cercle */
  @keyframes op-orb-disk {
    0%, 6% { clip-path: circle(0% at var(--ox) var(--oy)); }
    20% { clip-path: circle(38% at var(--ox) var(--oy)); }
    34% { clip-path: circle(80% at var(--ox) var(--oy)); }
    50%, 100% { clip-path: circle(150% at var(--ox) var(--oy)); }
  }
  @keyframes op-orb-media {
    0%, 20% { clip-path: circle(0% at var(--ox) var(--oy)); }
    36% { clip-path: circle(34% at var(--ox) var(--oy)); }
    54% { clip-path: circle(76% at var(--ox) var(--oy)); }
    74% { clip-path: circle(118% at var(--ox) var(--oy)); }
    88%, 100% { clip-path: circle(150% at var(--ox) var(--oy)); }
  }
  @keyframes op-counter { from { transform: translate3d(0, -60px, 0); } to { transform: translate3d(0, 60px, 0); } }
  @keyframes op-arrive { from { opacity: 0; translate: 0 calc(140px + var(--d) * 90px); rotate: calc(var(--rd) * 7deg); scale: 0.78; } 14% { opacity: 1; } to { opacity: 1; translate: 0 0; rotate: 0deg; scale: 1; } }
  @keyframes op-zoom { 0%, 18% { scale: 1.3; translate: 0 28px; } to { scale: 1.08; translate: 0 0; } }
  @keyframes op-band-l { from { translate: -104% 0; } to { translate: 0 0; } }
  @keyframes op-band-r { from { translate: 104% 0; } to { translate: 0 0; } }
  @keyframes op-block {
    0%, 18% { scale: 0 1; transform-origin: 0 50%; }
    50% { scale: 1 1; transform-origin: 0 50%; }
    50.5% { scale: 1 1; transform-origin: 100% 50%; }
    86%, 100% { scale: 0 1; transform-origin: 100% 50%; }
  }
  @keyframes op-block-media { 0%, 50% { opacity: 0; } 50.5%, 100% { opacity: 1; } }
  @keyframes op-block-inner { 0%, 50% { translate: -9% 28px; scale: 1.25; } 86%, 100% { translate: 0 0; scale: 1.08; } }
  @keyframes op-unfold { 0%, 18% { transform: perspective(1400px) rotateX(-88deg); } 82%, to { transform: perspective(1400px) rotateX(0deg); } }
  @keyframes op-unfold-shade { 0%, 18% { opacity: 0.85; transform: perspective(1400px) rotateX(-88deg); } 82%, to { opacity: 0; transform: perspective(1400px) rotateX(0deg); } }
  /* fenêtre qui s'ouvre (échelle du cadre) et contre-échelle de la photo (taille constante) */
  @keyframes op-iris {
    0%, 18% { scale: 0.001; } 22% { scale: 0.08; } 34% { scale: 0.3; } 46% { scale: 0.52; } 58% { scale: 0.72; }
