---
// Enveloppe commune: SEO technique + données structurées + navigation.
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { SITE, ui } from '../data/site.js';
import { localizePath, abs } from '../lib/seo.js';

const {
  lang = 'fr',
  path = '/',
  title,
  description = SITE.tagline[lang],
  ogType = 'website',
  image = lang === 'en' ? '/assets/og-en.png' : '/assets/og.png',
  jsonLd = [],
  noindex = false,
  isHome = false,
} = Astro.props;

const t = ui[lang];
const canonical = abs(localizePath(path, lang));
const altFr = abs(localizePath(path, 'fr'));
const altEn = abs(localizePath(path, 'en'));
const pageTitle = title ? `${title} – ${SITE.name}` : `${SITE.name} – ${SITE.tagline[lang]}`;
const ogImage = image.startsWith('http') ? image : abs(image);
const home = localizePath('/', lang);
const nav = [
  { href: localizePath('/projets', lang), label: t.nav.projets },
  { href: localizePath('/studios', lang), label: t.nav.studios },
  { href: localizePath('/offres', lang), label: t.nav.offres },
  { href: localizePath('/clients', lang), label: t.nav.clients },
];

// Entité de marque, valable sur tout le site (signal fort pour les moteurs IA et Google Knowledge Graph).
const org = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  '@id': abs('/') + '#organization',
  name: SITE.legalName,
  alternateName: ['Brunier & Obadia', 'BrunierObadia', 'Brunier Obadia Studios'],
  url: abs('/'),
  logo: abs('/assets/logo-480.png'),
  image: ogImage,
  description: SITE.tagline.fr,
  foundingDate: SITE.foundingDate,
  email: SITE.emails,
  telephone: SITE.phone,
  vatID: SITE.vatNumber,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.streetAddress,
    postalCode: SITE.address.postalCode,
    addressLocality: SITE.address.locality,
    addressCountry: SITE.address.country,
  },
  areaServed: ['FR', 'Worldwide'],
  knowsAbout: [
    'Communication créative',
    'Direction artistique',
    'Performance digitale',
    'Brand transformation',
    'AI Endorsement (recommandation des marques par les IA)',
    'Édition de luxe',
    'Architecture de marque'
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    email: SITE.emails[0],
    availableLanguage: ['French', 'English']
  },
  sameAs: [
    'https://www.linkedin.com/company/brunier-obadia/',
    'https://github.com/tomcu78/brunierobadia'
  ],
  // fondateurs et associés : faits sourcés (05_Equipe/02_Jean-Paul-Brunier_presence-web.md), identifiants stables
  // repris par la page Le studio (#jean-paul-brunier, #jonas-obadia…)
  founder: [
    {
      '@type': 'Person',
      '@id': abs('/studios') + '#jean-paul-brunier',
      name: 'Jean-Paul Brunier',
      jobTitle: 'Co-fondateur et stratège, BrunierObadia · Ancien président de Leo Burnett France',
      description: 'Président de Leo Burnett France à partir de 2008, vingt-deux ans chez Publicis Groupe (2000-2022), puis global client leader du groupe. Ancien président du pôle Société de l’AACC et administrateur de l’ARPP. Co-fondateur de BrunierObadia.',
      image: abs('/equipe/jean-paul-brunier.jpg'),
      url: abs('/studios') + '#jean-paul-brunier',
      worksFor: { '@id': abs('/') + '#organization' },
      alumniOf: [
        { '@type': 'Organization', name: 'Leo Burnett France' },
        { '@type': 'Organization', name: 'Publicis Groupe', sameAs: 'https://fr.wikipedia.org/wiki/Publicis_Groupe' }
      ],
      memberOf: [
        { '@type': 'Organization', name: 'AACC – Association des agences-conseils en communication', sameAs: 'https://fr.wikipedia.org/wiki/Association_des_agences-conseils_en_communication' },
        { '@type': 'Organization', name: 'ARPP – Autorité de régulation professionnelle de la publicité', sameAs: 'https://fr.wikipedia.org/wiki/Autorit%C3%A9_de_r%C3%A9gulation_professionnelle_de_la_publicit%C3%A9' }
      ],
      sameAs: [
        'https://www.linkedin.com/in/jean-paul-brunier-b8b7321',
        'https://atlantico.fr/author/jean-paul-brunier-1500532',
        'https://www.crunchbase.com/person/jean-paul-brunier'
      ],
      knowsAbout: ['Stratégie de marque', 'Publicité', 'Conseil aux directions générales', 'Régulation de la publicité', 'Communication responsable']
    },
    {
      '@type': 'Person',
      '@id': abs('/studios') + '#jonas-obadia',
      name: 'Jonas Obadia',
      jobTitle: 'Co-fondateur et directeur de création, président de Brunier Obadia Studios',
      description: 'Directeur artistique formé au design graphique et à la typographie : identités, éditions, scénographies et campagnes pour Hermès, Balenciaga, le Musée des Arts décoratifs (MAD Paris) et la collection Al Thani.',
      url: abs('/studios') + '#jonas-obadia',
      worksFor: { '@id': abs('/') + '#organization' },
      knowsAbout: ['Direction artistique', 'Typographie', 'Édition d’art', 'Identité visuelle', 'Scénographie']
    }
  ],
  employee: [
    { '@id': abs('/studios') + '#jean-paul-brunier' },
    { '@id': abs('/studios') + '#jonas-obadia' },
    {
      '@type': 'Person',
      '@id': abs('/studios') + '#tom-cottu',
      name: 'Tom Cottu',
      jobTitle: 'Partner AI Endorsement · ingénieur IA',
      description: 'Développeur spécialisé dans les architectures LLM et les agents autonomes. Pilote l’ingénierie d’AI Endorsement chez BrunierObadia et ses outils de mesure (GEO Monitor, GEO Qualifier, GEO Press).',
      url: abs('/studios') + '#tom-cottu',
      image: abs('/equipe/tom-cottu.jpg'),
      sameAs: ['https://www.linkedin.com/in/tom-cottu-881017359/'],
      worksFor: { '@id': abs('/') + '#organization' },
      knowsAbout: ['Generative Engine Optimization (GEO)', 'Architectures LLM', 'Agents autonomes', 'Visibilité des marques dans les IA']
    },
    { '@type': 'Person', '@id': abs('/studios') + '#christophe-attele', name: 'Christophe Attelé', jobTitle: 'Partner Brand Transformation' },
  ],
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/') + '#website',
  url: abs('/'),
  name: SITE.name,
  inLanguage: ['fr', 'en'],
  publisher: { '@id': abs('/') + '#organization' },
};
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  {isHome && (
    /* accueil : la boule rose du hero (le plus grand élément du premier écran) est demandée avant tout le reste */
    <link rel="preload" as="image" type="image/avif" fetchpriority="high" imagesrcset="/brand/sphere-rose-320.avif 320w, /brand/sphere-rose-400.avif 400w, /brand/sphere-rose-560.avif 560w, /brand/sphere-rose-800.avif 800w" imagesizes="(max-width: 820px) min(44vw, 200px), 17vw" />
  )}
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="fr" href={altFr} />
  <link rel="alternate" hreflang="en" href={altEn} />
  <link rel="alternate" hreflang="x-default" href={altFr} />

  <meta name="referrer" content="strict-origin-when-cross-origin" />

  <!-- Découverte Moteurs IA & Agents (Standard GEO / llms.txt) -->
  <link rel="help" type="text/plain" href="/llms.txt" title="LLM Knowledge File" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  <meta property="og:locale:alternate" content={lang === 'fr' ? 'en_GB' : 'fr_FR'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#510000" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <ClientRouter />

  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  <script type="application/ld+json" set:html={JSON.stringify(website)} />
  {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
</head>
<body>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <header class:list={["site-head", { "site-head--home": isHome }]}>
    <div class="bar">
      <a class="brand" href={home} aria-label={SITE.legalName}>
        <img src="/brand/logo.svg" alt={SITE.name} width="107" height="57" class="brand-logo" />
      </a>
      <nav class="main-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        {nav.map((item) => (
          <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="head-right">
        <div class="lang">
          <a href={altFr} class={lang === 'fr' ? 'active' : ''} hreflang="fr" aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
          <span aria-hidden="true">/</span>
          <a href={altEn} class={lang === 'en' ? 'active' : ''} hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </div>
        <a class="btn btn-primary head-cta" href={localizePath('/contact', lang)} aria-label={t.nav.contact}>
          <span class="head-cta-label">{t.nav.contact}</span><span class="ico" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="foot-col-title foot-kicker">{lang === 'fr' ? 'Agence de communication créative' : 'Creative communication agency'}</p>
            <p class="foot-tagline">{lang === 'fr' ? "50 ans d'expérience, plus de 200 marques." : '50 years of experience, over 200 brands.'}</p>
          </div>
          <div>
            <p class="foot-col-title">{lang === 'fr' ? 'Navigation' : 'Navigation'}</p>
            <ul>
              <li><a href={localizePath('/projets', lang)}>{t.nav.projets}</a></li>
              <li><a href={localizePath('/studios', lang)}>{t.nav.studios}</a></li>
              <li><a href={localizePath('/clients', lang)}>{t.nav.clients}</a></li>
              <li><a href={localizePath('/offres', lang)}>{t.nav.offres}</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-col-title">{t.nav.offres}</p>
            <ul>
              <li><a href={localizePath('/offres/creation', lang)}>{lang === 'fr' ? 'Création' : 'Creation'}</a></li>
              <li><a href={localizePath('/offres/brand-transformation', lang)}>Brand transformation</a></li>
              <li><a href={localizePath('/offres/la-marque-dans-les-ia', lang)}>AI Endorsement</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-col-title">{t.nav.contact}</p>
            <ul>
              {SITE.emails.map((e) => <li><a href={`mailto:${e}`}>{e}</a></li>)}
            </ul>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {new Date().getFullYear()} {SITE.legalName} · Paris</span>
          <div class="foot-legal-links">
            <a href={localizePath('/mentions-legales', lang)}>{lang === 'fr' ? 'Mentions légales' : 'Legal notice'}</a>
            <span aria-hidden="true">·</span>
            <a href={localizePath('/confidentialite', lang)}>{lang === 'fr' ? 'Confidentialité & RGPD' : 'Privacy policy & GDPR'}</a>
            <span aria-hidden="true">·</span>
            <a href={localizePath('/cgu', lang)}>{lang === 'fr' ? 'CGU' : 'Terms of use'}</a>
          </div>
        </div>
        <details class="foot-legal">
          <summary>{lang === 'fr' ? 'Informations légales' : 'Legal information'}</summary>
          <dl>
            <div><dt>{lang === 'fr' ? 'Société' : 'Company'}</dt><dd>{SITE.legalName}</dd></div>
            <div><dt>{lang === 'fr' ? 'Forme' : 'Legal form'}</dt><dd>{SITE.legalForm}, {lang === 'fr' ? 'au capital de' : 'share capital'} {SITE.shareCapital}</dd></div>
            <div><dt>{lang === 'fr' ? 'Siège' : 'Registered office'}</dt><dd>{SITE.headquarters}</dd></div>
            <div><dt>RCS</dt><dd>{SITE.rcs}</dd></div>
            <div><dt>SIRET</dt><dd>{SITE.siret}</dd></div>
            <div><dt>{lang === 'fr' ? 'TVA intracom.' : 'EU VAT'}</dt><dd>{SITE.vatNumber}</dd></div>
            <div><dt>{lang === 'fr' ? 'Publication' : 'Publisher'}</dt><dd>{SITE.publicationDirectors[lang]}</dd></div>
            <div><dt>{lang === 'fr' ? 'Hébergement' : 'Hosting'}</dt><dd>{SITE.host.name}, {SITE.host.address}</dd></div>
          </dl>
        </details>
      </div>
    </footer>

    <script is:inline>
      // Carrousels d'images au survol pour toutes les cartes projets (fidèle à brunierobadia.com)
      function initWorksCarousels() {
        const works = document.querySelectorAll('.work[data-images]');
        works.forEach((work) => {
          if (work.dataset.carouselInitialized) return;
          work.dataset.carouselInitialized = 'true';

          let images = [];
          try {
            images = JSON.parse(work.getAttribute('data-images') || '[]');
          } catch (e) {
            images = [];
          }
          if (!images || images.length <= 1) return;

          const img = work.querySelector('img');
          if (!img) return;

          // Création des indicateurs visuels discrets
          let dotsWrap = work.querySelector('.work-carousel-progress');
          if (!dotsWrap && images.length > 1) {
            dotsWrap = document.createElement('div');
            dotsWrap.className = 'work-carousel-progress';
            images.forEach((_, i) => {
              const dot = document.createElement('span');
              dot.className = `work-carousel-dot ${i === 0 ? 'active' : ''}`;
              dotsWrap.appendChild(dot);
            });
            const fig = work.querySelector('figure');
            if (fig) fig.appendChild(dotsWrap);
          }

          let intervalId = null;
          let currentIndex = 0;
          let preloaded = false;

          function preloadImages() {
            if (preloaded) return;
            preloaded = true;
            images.forEach((src) => {
              const pre = new Image();
              pre.src = src;
            });
          }

          function showImage(idx) {
            currentIndex = idx;
            img.src = images[idx];
            if (dotsWrap) {
              const dots = dotsWrap.querySelectorAll('.work-carousel-dot');
              dots.forEach((d, i) => d.classList.toggle('active', i === idx));
            }
          }

          work.addEventListener('mouseenter', () => {
            preloadImages();
            currentIndex = 0;
            showImage(0);
            intervalId = setInterval(() => {
              currentIndex = (currentIndex + 1) % images.length;
              showImage(currentIndex);
            }, 1000);
          });

          work.addEventListener('mouseleave', () => {
            if (intervalId) {
              clearInterval(intervalId);
              intervalId = null;
            }
            showImage(0);
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initWorksCarousels);
      document.addEventListener('astro:page-load', initWorksCarousels);
    </script>
  <script>
    // transition par la boule entre l'accueil et les offres (essai : Création)
    import '../scripts/ball-transition.js';
    // défilement lissé sur tout le site
    import '../scripts/smooth-scroll.js';
  </script>
</body>
</html>
