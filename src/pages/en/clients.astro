---
import Base from '../../layouts/Base.astro';
import { clients, ui, totalBrands } from '../../data/site.js';
import ClientsPage from '../../components/ClientsPage.astro';
import { abs } from '../../lib/seo.js';

const lang = 'en';
const t = ui[lang];


const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'BrunierObadia Client Brands',
  numberOfItems: totalBrands,
  itemListElement: clients
    .filter((c) => c.brands.length)
    .flatMap((c) => c.brands)
    .map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/en') },
    { '@type': 'ListItem', position: 2, name: 'Clients', item: abs('/en/clients') },
  ],
};
---

<Base
  lang={lang}
  path="/clients"
  title="Clients"
  description={`${totalBrands} brands and houses supported by BrunierObadia over 50 years: Hermès, Balenciaga, Aston Martin, Jeep, Samsung, Cartier, Dior, CNRS, TotalEnergies.`}
  jsonLd={[itemList, breadcrumb]}
>
  <div class="wrap">
    <ClientsPage lang={lang} />
  </div>
</Base>
