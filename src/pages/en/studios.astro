---
import Base from '../../layouts/Base.astro';
import { SITE, about, clients, totalBrands, ui } from '../../data/site.js';
import { abs, localizePath } from '../../lib/seo.js';
import StudiosPage from '../../components/StudiosPage.astro';

const lang = 'en';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'The Studios', item: abs('/en/studios') },
  ]
};
const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: abs('/en/studios'),
  name: 'The studio and team',
  about: { '@id': abs('/') + '#organization' },
  mainEntity: [{ '@id': abs('/studios') + '#jean-paul-brunier' }, { '@id': abs('/studios') + '#jonas-obadia' }],
  inLanguage: 'en',
};
---
<Base lang={lang} path="/studios" title="The studio and team – Jean-Paul Brunier, Jonas Obadia" description="BrunierObadia, a creative studio in Paris founded by Jean-Paul Brunier, former president of Leo Burnett France, and Jonas Obadia, creative director. The team, their careers, the method." jsonLd={[breadcrumb, aboutPage]}>
  <div class="wrap">
    <StudiosPage lang={lang} />
  </div>

  <section class="cta-band">
    <div class="ghost" aria-hidden="true">
      <span>brunier obadia · brunier obadia · brunier obadia ·&nbsp;</span>
    </div>
    <div class="wrap">
      <h2>Have a brand challenge or meeting in Paris?</h2>
      <a class="mail" href={`mailto:${SITE.emails[0]}`}>{SITE.emails[0]}</a>
    </div>
  </section>
</Base>
