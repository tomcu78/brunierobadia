---
import Base from '../../layouts/Base.astro';
import { SITE, projects, clients, offers, about, totalBrands, ui } from '../../data/site.js';
import HomeOnePager from '../../components/HomeOnePager.astro';
import { abs, localizePath } from '../../lib/seo.js';

const lang = 'en';
const description = 'BrunierObadia, creative communication agency in Paris. Art direction, creative craftsmanship and brand transformation. 50 years of experience, over 200 brands.';



const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'BrunierObadia projects',
  numberOfItems: projects.length,
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: abs(`/en/projets/${p.slug}`),
    name: `${p.client} – ${p.name_en}`
  })),
};
---
<Base isHome lang={lang} path="/" description={description} image="/projets/hermes-maison-hermes-les-podiums.webp" jsonLd={[itemList]}>
  <HomeOnePager lang={lang} />
</Base>
