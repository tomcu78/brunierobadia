---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../data/site.js';
import { abs } from '../../lib/seo.js';

const lang = 'en';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/en') },
    { '@type': 'ListItem', position: 2, name: 'Legal Notice', item: abs('/en/mentions-legales') },
  ],
};
---
<Base lang={lang} path="/mentions-legales" title="Legal Notice" description="Mandatory legal notice and statutory regulatory disclosures for BrunierObadia Studios under French law." jsonLd={[breadcrumb]}>
  <div class="wrap" style="padding-top:clamp(40px,6vw,90px);padding-bottom:clamp(60px,8vw,120px)">
    <div class="sec-head">
      <h1>Legal Notice</h1>
      <span class="label">Regulatory Compliance · LCEN & French Commercial Code</span>
    </div>

    <div class="legal-content prose" style="max-width:76ch;margin-top:clamp(32px,4vw,64px)">
      <p style="font-size:0.95rem;color:var(--muted);line-height:1.6;margin-bottom:32px">
        In accordance with the provisions of Articles 6-III and 19 of the French Law No. 2004-575 of June 21, 2004 for Trust in the Digital Economy (LCEN), as well as Article R. 123-237 of the French Commercial Code and the EU General Data Protection Regulation (GDPR 2016/679), site users are provided with the following statutory information.
      </p>

      <section style="border:none;padding:0 0 32px 0">
        <h3>1. Website Publisher</h3>
        <p>The website <strong>{SITE.url}</strong> is published and owned by:</p>
        <ul style="list-style:disc;padding-left:24px;margin:16px 0;line-height:1.8">
          <li><strong>Corporate Name:</strong> {SITE.legalName}</li>
          <li><strong>Legal Form:</strong> {SITE.legalForm}</li>
          <li><strong>Share Capital:</strong> {SITE.shareCapital}</li>
          <li><strong>Registered Headquarters:</strong> {SITE.headquarters}</li>
          <li><strong>SIREN Number:</strong> {SITE.siren}</li>
          <li><strong>SIRET Number (head office):</strong> {SITE.siret}</li>
          <li><strong>Trade &amp; Companies Register:</strong> R.C.S. {SITE.rcs}</li>
          <li><strong>EU Intra-Community VAT Number:</strong> {SITE.vatNumber}</li>
          <li><strong>APE / NAF Code:</strong> {SITE.codeApe}</li>
          <li><strong>Telephone:</strong> <a href={`tel:${SITE.phone.replace(/\s+/g, '')}`}>{SITE.phone}</a></li>
          <li><strong>Emails:</strong> <a href={`mailto:${SITE.emails[0]}`}>{SITE.emails[0]}</a> · <a href={`mailto:${SITE.emails[1]}`}>{SITE.emails[1]}</a></li>
        </ul>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>2. Publication Director</h3>
        <p>
          <strong>Publication Director:</strong><br />
          {SITE.publicationDirectors.en}<br />
          Contact: <a href={`mailto:${SITE.emails[0]}`}>{SITE.emails[0]}</a>
        </p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>3. Hosting Provider</h3>
        <p>
          The website is hosted by:<br />
          <strong>{SITE.host.name}</strong><br />
          Address: {SITE.host.address}<br />
          Telephone: {SITE.host.phone}<br />
          Website: <a href={SITE.host.url} target="_blank" rel="noopener noreferrer">{SITE.host.url}</a>
        </p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>4. Intellectual Property &amp; Copyright</h3>
        <p>
          All constituent elements of this website (including, without limitation, structural architecture, graphical work, typography, brand identities, texts, photographs, motion graphics, case studies, and source code) are protected under French and international intellectual property and copyright legislation (Articles L. 111-1 et seq. of the French Intellectual Property Code).
        </p>
        <p>
          Any unauthorized reproduction, adaptation, redistribution, or communication to the public, in whole or in part, without the prior written consent of <strong>{SITE.legalName}</strong> or its respective rights holders, constitutes copyright infringement actionable under Articles L. 335-2 et seq. of the Intellectual Property Code.
        </p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>5. Personal Data &amp; GDPR Compliance</h3>
        <p>
          For comprehensive details on how personal data is collected, processed, retained, and the rights you may exercise under the GDPR (EU Regulation 2016/679) and the amended French Data Protection Act, please consult our <a href="/en/confidentialite">Privacy Policy</a>, accessible via the footer of every page.
        </p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>6. Cookies &amp; Tracking Technologies</h3>
        <p>
          The website <strong>{SITE.url}</strong> does not deploy advertising trackers, behavioral profiling scripts, or non-essential third-party cookies requiring prior user consent under Article 82 of the French Data Protection Act and CNIL guidelines.
        </p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>7. Governing Law and Jurisdiction</h3>
        <p>
          This legal notice is governed by and construed in accordance with the laws of France. In the event of any dispute arising out of or related to this website, and failing amicable resolution, exclusive jurisdiction shall belong to the competent courts of the Paris Court of Appeal.
        </p>
      </section>
    </div>
  </div>
</Base>
