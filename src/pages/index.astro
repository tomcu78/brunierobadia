---
import Base from '../layouts/Base.astro';
import { SITE, projects, clients, offers, about, totalBrands, ui } from '../data/site.js';
import HomeOnePager from '../components/HomeOnePager.astro';
import { abs, localizePath } from '../lib/seo.js';

const lang = 'fr';
const description = "BrunierObadia, agence de communication créative à Paris. Direction artistique, création et brand transformation. 50 ans d'expérience, plus de 200 marques.";



const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Projets BrunierObadia',
  numberOfItems: projects.length,
  itemListElement: projects.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: abs(`/projets/${p.slug}`),
    name: `${p.client} – ${p.name_fr}`
  })),
};
---
<Base isHome lang={lang} path="/" description={description} image="/projets/hermes-maison-hermes-les-podiums.webp" jsonLd={[itemList]}>
  <HomeOnePager lang={lang} />
</Base>
