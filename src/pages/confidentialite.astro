---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
import { abs } from '../lib/seo.js';

const lang = 'fr';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Confidentialité', item: abs('/confidentialite') },
  ],
};
---
<Base lang={lang} path="/confidentialite" title="Politique de confidentialité" description="Politique de protection des données et de confidentialité de BrunierObadia Studios." jsonLd={[breadcrumb]}>
  <div class="wrap" style="padding-top:clamp(40px,6vw,90px);padding-bottom:clamp(60px,8vw,120px)">
    <div class="sec-head">
      <h1>Confidentialité</h1>
      <span class="label">RGPD · Vie privée</span>
    </div>

    <div class="legal-content prose" style="max-width:76ch;margin-top:clamp(32px,4vw,64px)">
      <section style="border:none;padding:0 0 32px 0">
        <h3>1. Engagement de confidentialité</h3>
        <p>BrunierObadia Studios accorde la plus haute importance à la protection et à la confidentialité des données personnelles de ses clients, prospects et visiteurs de son site web.</p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>2. Données collectées</h3>
        <p>Nous ne collectons que les informations strictement nécessaires à la communication professionnelle lorsque vous nous contactez par courriel (nom, prénom, adresse e-mail, numéro de téléphone, entreprise, nature du projet).<br />
        Ce site n'utilise aucun cookie publicitaire, ni traçage comportemental tiers.</p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>3. Utilisation et conservation</h3>
        <p>Les données transmises sont exploitées exclusivement dans le cadre de la relation commerciale et du suivi de vos projets. Elles sont conservées pour une durée n'excédant pas 3 ans à compter du dernier contact.</p>
      </section>

      <section style="border-top:1px solid var(--line);padding:32px 0">
        <h3>4. Vos droits</h3>
        <p>Vous bénéficiez à tout moment d'un droit d'accès, de rectification, de portabilité et d'effacement de vos données. Pour exercer ce droit, écrivez à : <a href={`mailto:${SITE.emails[0]}`}>{SITE.emails[0]}</a>.</p>
      </section>
    </div>
  </div>
</Base>
