---
import Base from '../layouts/Base.astro';
import { SITE, about, clients, totalBrands, ui } from '../data/site.js';
import { abs, localizePath } from '../lib/seo.js';
import StudiosPage from '../components/StudiosPage.astro';

const lang = 'fr';
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: 'Les Studios', item: abs('/studios') },
  ]
};
const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: abs('/studios'),
  name: 'Le studio et l’équipe',
  about: { '@id': abs('/') + '#organization' },
  mainEntity: [{ '@id': abs('/studios') + '#jean-paul-brunier' }, { '@id': abs('/studios') + '#jonas-obadia' }],
  inLanguage: 'fr',
};
---
<Base lang={lang} path="/studios" title="Le studio et l’équipe – Jean-Paul Brunier, Jonas Obadia" description="BrunierObadia, studio de création à Paris fondé par Jean-Paul Brunier, ancien président de Leo Burnett France, et Jonas Obadia, directeur de création. L’équipe, le parcours, la méthode." jsonLd={[breadcrumb, aboutPage]}>
  <div class="wrap">
    <StudiosPage lang={lang} />
  </div>

  <!-- Bandeau Contact Prestige -->
  <section class="cta-band">
    <div class="ghost" aria-hidden="true">
      <span>brunier obadia · brunier obadia · brunier obadia ·&nbsp;</span>
    </div>
    <div class="wrap">
      <h2>Un projet de marque, une rencontre à Paris ?</h2>
      <a class="mail" href={`mailto:${SITE.emails[0]}`}>{SITE.emails[0]}</a>
    </div>
  </section>
</Base>
